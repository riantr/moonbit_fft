  let input = ComplexImage::from_data([5, 4, 4], parity_in_c2r_3d_5x4x4())
  let output = RealImage::new([8, 4, 4])
  assert_true(complex_to_real(input, output, None, 0, true) == true)
  parity_assert_dims(output.dims, [8, 4, 4])
  parity_assert_floats(output.data, parity_out_c2r_3d_5x4x4(), 1.0e-6)
}

