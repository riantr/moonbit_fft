///|
test "parity C2R c2r_sweep_53" {
  let input = ComplexImage::from_data([53], parity_in_c2r_sweep_53())
  let output = RealImage::new([104])
  assert_true(complex_to_real(input, output, None, 0, true) == true)
  parity_assert_dims(output.dims, [104])
  parity_assert_floats(output.data, parity_out_c2r_sweep_53(), 1.0e-6)
}

