///|
test "parity SIZES sizes" {
  let expected = parity_extra_sizes()
  let mut n = 1
  while n <= 128 {
    assert_true(
      nfft_fast_real(n) == expected[4 * (n - 1) + 0],
      msg="real fast length \{n}: expected \{expected[4 * (n - 1) + 0]}, got \{nfft_fast_real(n)}",
    )
    assert_true(
      nfft_small_real(n) == expected[4 * (n - 1) + 1],
      msg="real small length \{n}: expected \{expected[4 * (n - 1) + 1]}, got \{nfft_small_real(n)}",
    )
    assert_true(
      nfft_fast(n) == expected[4 * (n - 1) + 2],
      msg="complex fast length \{n}: expected \{expected[4 * (n - 1) + 2]}, got \{nfft_fast(n)}",
    )
    assert_true(
      nfft_small(n) == expected[4 * (n - 1) + 3],
      msg="complex small length \{n}: expected \{expected[4 * (n - 1) + 3]}, got \{nfft_small(n)}",
    )
    n = n + 1
  }
}

