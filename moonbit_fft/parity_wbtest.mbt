/// Parity tests against the original Java `net.imglib2.algorithm.fft2`
/// implementation.
///
/// This file is generated by `tools/gen_parity.py`; every expectation
/// below is the output of the original Java bytecode, captured by
/// `tools/java/Oracle.java`.

///|
/// Asserts that two arrays of floats agree within the single
/// precision tolerance of the two different FFT kernels.
///
/// The tolerance is relative to the magnitude of the whole
/// expected result: a single sample may be close to zero even
/// though the transform that produced it was not.
fn parity_assert_floats(
  actual : Array[Float],
  expected : Array[Float],
  tolerance : Float,
) -> Unit raise {
  assert_true(
    actual.length() == expected.length(),
    msg="expected \{expected.length()} values, got \{actual.length()}",
  )
  let mut scale = Float::from_double(1.0)
  let mut i = 0
  while i < expected.length() {
    let magnitude = expected[i].abs()
    if magnitude > scale {
      scale = magnitude
    }
    i = i + 1
  }
  let mut i = 0
  while i < expected.length() {
    let want = expected[i]
    let got = actual[i]
    let diff = (got - want).abs()
    let allowed = tolerance * (scale + want.abs())
    assert_true(
      diff <= allowed,
      msg="value \{i}: expected \{want}, got \{got}, allowed \{allowed}",
    )
    i = i + 1
  }
}

///|
/// Asserts that two extent arrays are identical.
fn parity_assert_dims(
  actual : Array[Int32],
  expected : Array[Int32],
) -> Unit raise {
  assert_true(
    actual.length() == expected.length(),
    msg="expected \{expected.length()} dimensions, got \{actual.length()}",
  )
  let mut i = 0
  while i < expected.length() {
    assert_true(
      actual[i] == expected[i],
      msg="dimension \{i}: expected \{expected[i]}, got \{actual[i]}",
    )
    i = i + 1
  }
}

///|
/// Asserts that two arrays of integers are identical.
fn parity_assert_ints(
  actual : Array[Int32],
  expected : Array[Int32],
) -> Unit raise {
  assert_true(
    actual.length() == expected.length(),
    msg="expected \{expected.length()} values, got \{actual.length()}",
  )
  let mut i = 0
  while i < expected.length() {
    assert_true(
      actual[i] == expected[i],
      msg="value \{i}: expected \{expected[i]}, got \{actual[i]}",
    )
    i = i + 1
  }
}

