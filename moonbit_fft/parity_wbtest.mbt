  let input = ComplexImage::from_data([5], parity_in_fft_c2r_unpad_1d_5_to_4())
  let output = fft_complex_to_real_unpad(input, [4])
  parity_assert_dims(output.dims, [4])
  parity_assert_floats(
    output.data,
    parity_out_fft_c2r_unpad_1d_5_to_4(),
    1.0e-6,
  )
}

