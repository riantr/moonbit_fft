  let fft = FftComplex::new(1)
  let cx = parity_in_jc2c_1d_1_fwd()
  let cy = Array::make(2, Float::from_double(0.0))
  fft.complex_to_complex(-1, cx, cy)
  parity_assert_floats(cy, parity_out_jc2c_1d_1_fwd(), 1.0e-6)
}

