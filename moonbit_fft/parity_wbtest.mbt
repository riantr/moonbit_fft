///|
test "parity JC2C jc2c_1d_4095_inv" {
  let fft = FftComplex::new(4095)
  let cx = parity_in_jc2c_1d_4095_inv()
  let cy = Array::make(8190, Float::from_double(0.0))
  fft.complex_to_complex(1, cx, cy)
  parity_assert_floats(cy, parity_out_jc2c_1d_4095_inv(), 1.0e-6)
}
