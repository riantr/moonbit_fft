///|
test "parity FFT_C2R_FACTORY fft_c2r_factory_3d_5x4x4" {
  let input = ComplexImage::from_data(
    [5, 4, 4],
    parity_in_fft_c2r_factory_3d_5x4x4(),
  )
  let output = fft_complex_to_real(input)
  parity_assert_dims(output.dims, [8, 4, 4])
  parity_assert_floats(
    output.data,
    parity_out_fft_c2r_factory_3d_5x4x4(),
    1.0e-6,
  )
}

