test "parity FFT_C2R_FACTORY fft_c2r_factory_sweep_61" {
  let input = ComplexImage::from_data(
    [61, 1],
    parity_in_fft_c2r_factory_sweep_61(),
  )
  let output = fft_complex_to_real(input)
  parity_assert_dims(output.dims, [120, 1])
  parity_assert_floats(
    output.data,
    parity_out_fft_c2r_factory_sweep_61(),
    1.0e-6,
  )
}

