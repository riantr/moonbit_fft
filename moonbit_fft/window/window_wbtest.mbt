// Generated by `tools/gen_windows.py`, do not edit.
//
// The coefficients below are the coefficients of `numpy`, and of `scipy` for the
// flat top window.  They are the reference of these functions, because the
// original Java bytecode that the rest of the module is verified against has no
// window at all: `python tools/gen_windows.py --check` regenerates this file and
// proves that it still holds them.

///|
/// Asserts that the coefficients of a window are those of the reference, to
/// within `tolerance`.
fn close_enough(
  actual : Array[Double],
  expected : Array[Double],
  tolerance : Double,
  what : String,
) -> Unit raise {
  if actual.length() != expected.length() {
    abort(
      "\{what}: \{actual.length()} coefficients, the reference has \{expected.length()}",
    )
  }
  let mut worst = 0.0
  let mut i = 0
  while i < actual.length() {
    let difference = (actual[i] - expected[i]).abs()
    if difference > worst {
      worst = difference
    }
    i = i + 1
  }
  assert_true(
    worst <= tolerance,
    msg="\{what}: the worst coefficient differs by \{worst}",
  )
}

///|
test "hanning, symmetric" {
  close_enough(hanning(1), [1.0], 1.0000000000000001e-15, "hanning at 1")
  close_enough(hanning(2), [0.0, 0.0], 1.0000000000000001e-15, "hanning at 2")
  close_enough(
    hanning(3),
    [0.0, 1.0, 0.0],
    1.0000000000000001e-15,
    "hanning at 3",
  )
  close_enough(
    hanning(5),
    [0.0, 0.5, 1.0, 0.5, 0.0],
    1.0000000000000001e-15,
    "hanning at 5",
  )
  close_enough(
    hanning(16),
    [
      0.0, 0.043227271178699511, 0.16543469682057105, 0.34549150281252633, 0.55226423163382676,
      0.75, 0.90450849718747373, 0.98907380036690284, 0.98907380036690284, 0.90450849718747373,
      0.75, 0.55226423163382676, 0.34549150281252633, 0.16543469682057105, 0.043227271178699511,
      0.0,
    ],
    1.0000000000000001e-15,
    "hanning at 16",
  )
}

