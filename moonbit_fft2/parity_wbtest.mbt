///|
test "parity C2R c2r_sweep_60" {
  let input = ComplexImage::from_data([60], parity_in_c2r_sweep_60())
  let output = RealImage::new([118])
  assert_true(complex_to_real(input, output, None, 0, true) == false)
  parity_assert_dims(output.dims, [118])
  parity_assert_floats(output.data, parity_out_c2r_sweep_60(), 1.0e-6)
}

