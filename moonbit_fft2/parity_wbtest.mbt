}

///|
test "parity DIMS_C2R_SMALL dims_c2r_small_sweep_55" {
  let complex_sizes = zeros(1)
  let real_sizes = zeros(1)
  dimensions_complex_to_real_small([55], complex_sizes, real_sizes)
  let expected = parity_extra_dims_c2r_small_sweep_55()
