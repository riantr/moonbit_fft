///|
test "parity FFT_C2R_UNPAD fft_c2r_unpad_2d_9x8_to_8x4" {
  let input = ComplexImage::from_data(
    [9, 8],
    parity_in_fft_c2r_unpad_2d_9x8_to_8x4(),
  )
  let output = fft_complex_to_real_unpad(input, [8, 4])
  parity_assert_dims(output.dims, [8, 4])
  parity_assert_floats(
    output.data,
    parity_out_fft_c2r_unpad_2d_9x8_to_8x4(),
    1.0e-6,
  )
}

