///|
test "parity C2R c2r_sweep_64" {
  let input = ComplexImage::from_data([64], parity_in_c2r_sweep_64())
  let output = RealImage::new([126])
  assert_true(complex_to_real(input, output, None, 0, true) == true)
  parity_assert_dims(output.dims, [126])
  parity_assert_floats(output.data, parity_out_c2r_sweep_64(), 1.0e-6)
}

