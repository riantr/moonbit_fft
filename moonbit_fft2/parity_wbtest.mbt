///|
test "parity FFT_C2R_FACTORY fft_c2r_factory_sweep_41" {
  let input = ComplexImage::from_data(
    [41, 1],
    parity_in_fft_c2r_factory_sweep_41(),
  )
  let output = fft_complex_to_real(input)
  parity_assert_dims(output.dims, [80, 1])
  parity_assert_floats(
    output.data,
    parity_out_fft_c2r_factory_sweep_41(),
    1.0e-6,
  )
}

