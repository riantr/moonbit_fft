  let real_sizes = zeros(1)
  dimensions_real_to_complex_fast([60], complex_sizes, real_sizes)
  let expected = parity_extra_dims_r2c_sweep_60()
  let mut i = 0
  while i < complex_sizes.length() {
    assert_true(
      real_sizes[i] == expected[2 * i],
      msg="real size \{i}: expected \{expected[2 * i]}, got \{real_sizes[i]}",
    )
    assert_true(
      complex_sizes[i] == expected[2 * i + 1],
      msg="complex size \{i}: expected \{expected[2 * i + 1]}, got \{complex_sizes[i]}",
    )
    i = i + 1
  }
}

