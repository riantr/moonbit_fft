///|
fn parity_in_r2c_sweep_1() -> Array[Float] {
  [Float::from_double(-0.69497067)]
}

///|
fn parity_out_r2c_sweep_1() -> Array[Float] {
  [Float::from_double(0.0), Float::from_double(0.0)]
}

///|
test "parity R2C r2c_sweep_1" {
  let input = RealImage::from_data([1], parity_in_r2c_sweep_1())
  let output = ComplexImage::new([1])
  assert_true(real_to_complex(input, output, None, 0, false) == false)
  parity_assert_dims(output.dims, [1])
  parity_assert_floats(output.data, parity_out_r2c_sweep_1(), 1.0e-6)
}

