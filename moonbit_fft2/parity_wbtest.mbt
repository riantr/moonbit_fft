///|
test "parity R2C r2c_1d_8" {
  let input = RealImage::from_data([8], parity_in_r2c_1d_8())
  let output = ComplexImage::new([5])
  assert_true(real_to_complex(input, output, None, 0, false) == true)
  parity_assert_dims(output.dims, [5])
  parity_assert_floats(output.data, parity_out_r2c_1d_8(), 1.0e-6)
}

