///|
test "parity FFT_C2R_UNPAD fft_c2r_unpad_3d_9x8x4_to_8x4x2" {
  let input = ComplexImage::from_data(
    [9, 8, 4],
    parity_in_fft_c2r_unpad_3d_9x8x4_to_8x4x2(),
  )
  let output = fft_complex_to_real_unpad(input, [8, 4, 2])
  parity_assert_dims(output.dims, [8, 4, 2])
  parity_assert_floats(
    output.data,
    parity_out_fft_c2r_unpad_3d_9x8x4_to_8x4x2(),
    1.0e-6,
  )
}

///|
fn parity_extra_pad_8x4() -> Array[Int32] {
  [-4, 11, -2, 5]
}

///|
test "parity PAD pad_8x4" {
  let padded = padding_interval_centered(Interval::new([8, 4]), [16, 8])
  let expected = parity_extra_pad_8x4()
  parity_assert_dims(padded.dims(), [16, 8])
  let mut i = 0
  while i < padded.min.length() {
    assert_true(
      padded.min[i] == expected[2 * i],
      msg="min[\{i}]: expected \{expected[2 * i]}, got \{padded.min[i]}",
    )
    assert_true(
      padded.max[i] == expected[2 * i + 1],
      msg="max[\{i}]: expected \{expected[2 * i + 1]}, got \{padded.max[i]}",
    )
    i = i + 1
  }
}

