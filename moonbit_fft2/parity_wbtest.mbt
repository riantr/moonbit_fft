///|
test "parity R2C r2c_2d_16x8" {
  let input = RealImage::from_data([16, 8], parity_in_r2c_2d_16x8())
  let output = ComplexImage::new([9, 8])
  assert_true(real_to_complex(input, output, None, 0, false) == true)
  parity_assert_dims(output.dims, [9, 8])
  parity_assert_floats(output.data, parity_out_r2c_2d_16x8(), 1.0e-6)
}

