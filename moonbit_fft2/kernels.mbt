  let mut p3 = m * (3 * kfac % 9)
  let mut p4 = m * (4 * kfac % 9)
  let mut p5 = m * (5 * kfac % 9)
  let mut p6 = m * (6 * kfac % 9)
  let mut p7 = m * (7 * kfac % 9)
  let mut p8 = m * (8 * kfac % 9)
  let c1 = 0.866025403784439
  let c2 = 0.7660444431189781
  let c3 = 0.6427876096865394
  let c4 = 0.17364817766693047
  let c5 = 0.984807753012208
  let c6 = 0.6634139481689387
  let c7 = 0.5566703992264197
  let c8 = 0.15038373318043546
  let c9 = 0.8528685319524436
  let mut i = 0
  while i < m {
    let t1r = re[p3] + re[p6]
    let t1i = im[p3] + im[p6]
    let t2r = re[p0] - 0.5 * t1r
    let t2i = im[p0] - 0.5 * t1i
    let t3r = c1 * (re[p3] - re[p6])
    let t3i = c1 * (im[p3] - im[p6])
    let t4r = re[p0] + t1r
    let t4i = im[p0] + t1i
    let t5r = re[p4] + re[p7]
    let t5i = im[p4] + im[p7]
    let t6r = re[p1] - 0.5 * t5r
    let t6i = im[p1] - 0.5 * t5i
    let t7r = re[p4] - re[p7]
    let t7i = im[p4] - im[p7]
    let t8r = re[p1] + t5r
    let t8i = im[p1] + t5i
    let t9r = re[p2] + re[p5]
    let t9i = im[p2] + im[p5]
    let t10r = re[p8] - 0.5 * t9r
    let t10i = im[p8] - 0.5 * t9i
    let t11r = re[p2] - re[p5]
    let t11i = im[p2] - im[p5]
    let t12r = re[p8] + t9r
    let t12i = im[p8] + t9i
    let t13r = t8r + t12r
    let t13i = t8i + t12i
    let t14r = t6r + t10r
    let t14i = t6i + t10i
    let t15r = t6r - t10r
    let t15i = t6i - t10i
    let t16r = t7r + t11r
    let t16i = t7i + t11i
    let t17r = t7r - t11r
    let t17i = t7i - t11i
    let t18r = c2 * t14r - c7 * t17r
    let t18i = c2 * t14i - c7 * t17i
    let t19r = c4 * t14r + c9 * t17r
    let t19i = c4 * t14i + c9 * t17i
