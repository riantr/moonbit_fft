    c5_re = c5_re + a6_re * c4
    c5_im = c5_im + a6_im * c4
    d5_re = d5_re + b6_re * s4
    d5_im = d5_im + b6_im * s4
    out5_re = c5_re + d5_im
    out5_im = c5_im - d5_re
    out8_re = c5_re - d5_im
    out8_im = c5_im + d5_re
    let mut out6_re = 0.0
    let mut out6_im = 0.0
    let mut out7_re = 0.0
    let mut out7_im = 0.0
    let mut c6_re = 0.0
    let mut c6_im = 0.0
    c6_re = v0_re
    c6_im = v0_im
    let mut d6_re = 0.0
    let mut d6_im = 0.0
    c6_re = c6_re + a1_re * c6
    c6_im = c6_im + a1_im * c6
    d6_re = d6_re + b1_re * s6
    d6_im = d6_im + b1_im * s6
    c6_re = c6_re + a2_re * c1
    c6_im = c6_im + a2_im * c1
    d6_re = d6_re - b2_re * s1
    d6_im = d6_im - b2_im * s1
    c6_re = c6_re + a3_re * c5
    c6_im = c6_im + a3_im * c5
    d6_re = d6_re + b3_re * s5
    d6_im = d6_im + b3_im * s5
    c6_re = c6_re + a4_re * c2
    c6_im = c6_im + a4_im * c2
    d6_re = d6_re - b4_re * s2
    d6_im = d6_im - b4_im * s2
    c6_re = c6_re + a5_re * c4
    c6_im = c6_im + a5_im * c4
    d6_re = d6_re + b5_re * s4
    d6_im = d6_im + b5_im * s4
    c6_re = c6_re + a6_re * c3
    c6_im = c6_im + a6_im * c3
    d6_re = d6_re - b6_re * s3
    d6_im = d6_im - b6_im * s3
    out6_re = c6_re + d6_im
    out6_im = c6_im - d6_re
    out7_re = c6_re - d6_im
    out7_im = c6_im + d6_re
    re[p0] = out0_re
    im[p0] = out0_im
    re[p1] = out1_re
    im[p1] = out1_im
    re[p2] = out2_re
    im[p2] = out2_im
    re[p3] = out3_re
    im[p3] = out3_im
    re[p4] = out4_re
    im[p4] = out4_im
    re[p5] = out5_re
    im[p5] = out5_im
    re[p6] = out6_re
    im[p6] = out6_im
    re[p7] = out7_re
    im[p7] = out7_im
    re[p8] = out8_re
    im[p8] = out8_im
    re[p9] = out9_re
    im[p9] = out9_im
    re[p10] = out10_re
    im[p10] = out10_im
    re[p11] = out11_re
    im[p11] = out11_im
    re[p12] = out12_re
    im[p12] = out12_im
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    if p11 < limit {
      p11 = p11 + mr
    }
    p11 = p11 + delta
    if p12 < limit {
      p12 = p12 + mr
    }
    p12 = p12 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 16 stage of the Good-Thomas transform.
///
/// The values of the butterfly are read from `re` and `im`, the
/// roots of unity of the stage from `consts`, and the result is
/// written back to `re` and `im`.
///
/// The constants of the stage start at `off` in `consts`: the
/// cosines of the 9 roots come first, then the sines.
fn stage_r16(
  m : Int32,
  kfac : Int32,
  consts : Array[Double],
  off : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 16
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 16)
  let mut p1 = m * (1 * kfac % 16)
  let mut p2 = m * (2 * kfac % 16)
  let mut p3 = m * (3 * kfac % 16)
  let mut p4 = m * (4 * kfac % 16)
  let mut p5 = m * (5 * kfac % 16)
  let mut p6 = m * (6 * kfac % 16)
  let mut p7 = m * (7 * kfac % 16)
  let mut p8 = m * (8 * kfac % 16)
  let mut p9 = m * (9 * kfac % 16)
  let mut p10 = m * (10 * kfac % 16)
  let mut p11 = m * (11 * kfac % 16)
  let mut p12 = m * (12 * kfac % 16)
  let mut p13 = m * (13 * kfac % 16)
  let mut p14 = m * (14 * kfac % 16)
  let mut p15 = m * (15 * kfac % 16)
  let c1 = consts[off + 1]
  let c2 = consts[off + 2]
  let c3 = consts[off + 3]
  let c5 = consts[off + 5]
  let c6 = consts[off + 6]
  let c7 = consts[off + 7]
  let s1 = consts[off + 10]
  let s2 = consts[off + 11]
  let s3 = consts[off + 12]
  let s4 = consts[off + 13]
  let s5 = consts[off + 14]
  let s6 = consts[off + 15]
  let s7 = consts[off + 16]
  let mut i = 0
  while i < m {
    let v0_re = re[p0]
    let v0_im = im[p0]
    let v1_re = re[p1]
    let v1_im = im[p1]
    let v2_re = re[p2]
    let v2_im = im[p2]
    let v3_re = re[p3]
    let v3_im = im[p3]
    let v4_re = re[p4]
    let v4_im = im[p4]
    let v5_re = re[p5]
    let v5_im = im[p5]
    let v6_re = re[p6]
    let v6_im = im[p6]
    let v7_re = re[p7]
    let v7_im = im[p7]
    let v8_re = re[p8]
    let v8_im = im[p8]
    let v9_re = re[p9]
    let v9_im = im[p9]
    let v10_re = re[p10]
    let v10_im = im[p10]
    let v11_re = re[p11]
    let v11_im = im[p11]
    let v12_re = re[p12]
    let v12_im = im[p12]
    let v13_re = re[p13]
    let v13_im = im[p13]
    let v14_re = re[p14]
    let v14_im = im[p14]
    let v15_re = re[p15]
    let v15_im = im[p15]
    let a1_re = v1_re + v15_re
    let a1_im = v1_im + v15_im
    let b1_re = v1_re - v15_re
    let b1_im = v1_im - v15_im
    let a2_re = v2_re + v14_re
    let a2_im = v2_im + v14_im
    let b2_re = v2_re - v14_re
    let b2_im = v2_im - v14_im
    let a3_re = v3_re + v13_re
    let a3_im = v3_im + v13_im
    let b3_re = v3_re - v13_re
    let b3_im = v3_im - v13_im
    let a4_re = v4_re + v12_re
    let a4_im = v4_im + v12_im
    let b4_re = v4_re - v12_re
    let b4_im = v4_im - v12_im
    let a5_re = v5_re + v11_re
    let a5_im = v5_im + v11_im
    let b5_re = v5_re - v11_re
    let b5_im = v5_im - v11_im
    let a6_re = v6_re + v10_re
    let a6_im = v6_im + v10_im
    let b6_re = v6_re - v10_re
    let b6_im = v6_im - v10_im
    let a7_re = v7_re + v9_re
    let a7_im = v7_im + v9_im
    let b7_re = v7_re - v9_re
    let b7_im = v7_im - v9_im
    let mut out0_re = 0.0
    let mut out0_im = 0.0
    out0_re = out0_re + v0_re
    out0_im = out0_im + v0_im
    out0_re = out0_re + v1_re
    out0_im = out0_im + v1_im
    out0_re = out0_re + v2_re
    out0_im = out0_im + v2_im
    out0_re = out0_re + v3_re
    out0_im = out0_im + v3_im
    out0_re = out0_re + v4_re
    out0_im = out0_im + v4_im
    out0_re = out0_re + v5_re
    out0_im = out0_im + v5_im
    out0_re = out0_re + v6_re
    out0_im = out0_im + v6_im
    out0_re = out0_re + v7_re
    out0_im = out0_im + v7_im
    out0_re = out0_re + v8_re
    out0_im = out0_im + v8_im
    out0_re = out0_re + v9_re
    out0_im = out0_im + v9_im
    out0_re = out0_re + v10_re
    out0_im = out0_im + v10_im
    out0_re = out0_re + v11_re
    out0_im = out0_im + v11_im
    out0_re = out0_re + v12_re
    out0_im = out0_im + v12_im
    out0_re = out0_re + v13_re
    out0_im = out0_im + v13_im
    out0_re = out0_re + v14_re
    out0_im = out0_im + v14_im
    out0_re = out0_re + v15_re
    out0_im = out0_im + v15_im
    let mut out8_re = 0.0
    let mut out8_im = 0.0
    out8_re = out8_re + v0_re
    out8_im = out8_im + v0_im
    out8_re = out8_re - v1_re
    out8_im = out8_im - v1_im
    out8_re = out8_re + v2_re
    out8_im = out8_im + v2_im
    out8_re = out8_re - v3_re
    out8_im = out8_im - v3_im
    out8_re = out8_re + v4_re
    out8_im = out8_im + v4_im
    out8_re = out8_re - v5_re
    out8_im = out8_im - v5_im
    out8_re = out8_re + v6_re
    out8_im = out8_im + v6_im
    out8_re = out8_re - v7_re
    out8_im = out8_im - v7_im
    out8_re = out8_re + v8_re
    out8_im = out8_im + v8_im
    out8_re = out8_re - v9_re
    out8_im = out8_im - v9_im
    out8_re = out8_re + v10_re
    out8_im = out8_im + v10_im
    out8_re = out8_re - v11_re
    out8_im = out8_im - v11_im
    out8_re = out8_re + v12_re
    out8_im = out8_im + v12_im
    out8_re = out8_re - v13_re
    out8_im = out8_im - v13_im
    out8_re = out8_re + v14_re
    out8_im = out8_im + v14_im
    out8_re = out8_re - v15_re
    out8_im = out8_im - v15_im
    let mut out1_re = 0.0
    let mut out1_im = 0.0
    let mut out15_re = 0.0
    let mut out15_im = 0.0
    let mut c1_re = 0.0
    let mut c1_im = 0.0
    c1_re = v0_re
    c1_im = v0_im
    let mut d1_re = 0.0
    let mut d1_im = 0.0
    c1_re = c1_re + a1_re * c1
    c1_im = c1_im + a1_im * c1
    d1_re = d1_re + b1_re * s1
    d1_im = d1_im + b1_im * s1
    c1_re = c1_re + a2_re * c2
    c1_im = c1_im + a2_im * c2
    d1_re = d1_re + b2_re * s2
    d1_im = d1_im + b2_im * s2
    c1_re = c1_re + a3_re * c3
    c1_im = c1_im + a3_im * c3
    d1_re = d1_re + b3_re * s3
    d1_im = d1_im + b3_im * s3
    d1_re = d1_re + b4_re * s4
    d1_im = d1_im + b4_im * s4
    c1_re = c1_re + a5_re * c5
    c1_im = c1_im + a5_im * c5
    d1_re = d1_re + b5_re * s5
    d1_im = d1_im + b5_im * s5
    c1_re = c1_re + a6_re * c6
    c1_im = c1_im + a6_im * c6
    d1_re = d1_re + b6_re * s6
    d1_im = d1_im + b6_im * s6
    c1_re = c1_re + a7_re * c7
    c1_im = c1_im + a7_im * c7
    d1_re = d1_re + b7_re * s7
    d1_im = d1_im + b7_im * s7
    out1_re = c1_re + d1_im - v8_re
    out1_im = c1_im - d1_re - v8_im
    out15_re = c1_re - d1_im - v8_re
    out15_im = c1_im + d1_re - v8_im
    let mut out2_re = 0.0
    let mut out2_im = 0.0
    let mut out14_re = 0.0
    let mut out14_im = 0.0
    let mut c2_re = 0.0
    let mut c2_im = 0.0
    c2_re = v0_re
    c2_im = v0_im
    let mut d2_re = 0.0
    let mut d2_im = 0.0
    c2_re = c2_re + a1_re * c2
    c2_im = c2_im + a1_im * c2
    d2_re = d2_re + b1_re * s2
    d2_im = d2_im + b1_im * s2
    d2_re = d2_re + b2_re * s4
    d2_im = d2_im + b2_im * s4
    c2_re = c2_re + a3_re * c6
    c2_im = c2_im + a3_im * c6
    d2_re = d2_re + b3_re * s6
    d2_im = d2_im + b3_im * s6
    c2_re = c2_re - a4_re
    c2_im = c2_im - a4_im
    c2_re = c2_re + a5_re * c6
    c2_im = c2_im + a5_im * c6
    d2_re = d2_re - b5_re * s6
    d2_im = d2_im - b5_im * s6
    d2_re = d2_re - b6_re * s4
    d2_im = d2_im - b6_im * s4
    c2_re = c2_re + a7_re * c2
    c2_im = c2_im + a7_im * c2
    d2_re = d2_re - b7_re * s2
    d2_im = d2_im - b7_im * s2
    out2_re = c2_re + d2_im + v8_re
    out2_im = c2_im - d2_re + v8_im
    out14_re = c2_re - d2_im + v8_re
    out14_im = c2_im + d2_re + v8_im
    let mut out3_re = 0.0
    let mut out3_im = 0.0
    let mut out13_re = 0.0
    let mut out13_im = 0.0
    let mut c3_re = 0.0
    let mut c3_im = 0.0
    c3_re = v0_re
    c3_im = v0_im
    let mut d3_re = 0.0
    let mut d3_im = 0.0
    c3_re = c3_re + a1_re * c3
    c3_im = c3_im + a1_im * c3
    d3_re = d3_re + b1_re * s3
    d3_im = d3_im + b1_im * s3
    c3_re = c3_re + a2_re * c6
    c3_im = c3_im + a2_im * c6
    d3_re = d3_re + b2_re * s6
    d3_im = d3_im + b2_im * s6
    c3_re = c3_re + a3_re * c7
    c3_im = c3_im + a3_im * c7
    d3_re = d3_re - b3_re * s7
    d3_im = d3_im - b3_im * s7
    d3_re = d3_re - b4_re * s4
    d3_im = d3_im - b4_im * s4
    c3_re = c3_re + a5_re * c1
    c3_im = c3_im + a5_im * c1
    d3_re = d3_re - b5_re * s1
    d3_im = d3_im - b5_im * s1
    c3_re = c3_re + a6_re * c2
    c3_im = c3_im + a6_im * c2
    d3_re = d3_re + b6_re * s2
    d3_im = d3_im + b6_im * s2
    c3_re = c3_re + a7_re * c5
    c3_im = c3_im + a7_im * c5
    d3_re = d3_re + b7_re * s5
    d3_im = d3_im + b7_im * s5
    out3_re = c3_re + d3_im - v8_re
    out3_im = c3_im - d3_re - v8_im
    out13_re = c3_re - d3_im - v8_re
    out13_im = c3_im + d3_re - v8_im
    let mut out4_re = 0.0
    let mut out4_im = 0.0
    let mut out12_re = 0.0
    let mut out12_im = 0.0
    let mut c4_re = 0.0
    let mut c4_im = 0.0
    c4_re = v0_re
    c4_im = v0_im
    let mut d4_re = 0.0
    let mut d4_im = 0.0
    d4_re = d4_re + b1_re * s4
    d4_im = d4_im + b1_im * s4
    c4_re = c4_re - a2_re
    c4_im = c4_im - a2_im
    d4_re = d4_re - b3_re * s4
    d4_im = d4_im - b3_im * s4
    c4_re = c4_re + a4_re
    c4_im = c4_im + a4_im
    d4_re = d4_re + b5_re * s4
    d4_im = d4_im + b5_im * s4
    c4_re = c4_re - a6_re
    c4_im = c4_im - a6_im
    d4_re = d4_re - b7_re * s4
    d4_im = d4_im - b7_im * s4
    out4_re = c4_re + d4_im + v8_re
    out4_im = c4_im - d4_re + v8_im
    out12_re = c4_re - d4_im + v8_re
    out12_im = c4_im + d4_re + v8_im
    let mut out5_re = 0.0
    let mut out5_im = 0.0
    let mut out11_re = 0.0
    let mut out11_im = 0.0
    let mut c5_re = 0.0
    let mut c5_im = 0.0
    c5_re = v0_re
    c5_im = v0_im
    let mut d5_re = 0.0
    let mut d5_im = 0.0
    c5_re = c5_re + a1_re * c5
    c5_im = c5_im + a1_im * c5
    d5_re = d5_re + b1_re * s5
    d5_im = d5_im + b1_im * s5
    c5_re = c5_re + a2_re * c6
    c5_im = c5_im + a2_im * c6
    d5_re = d5_re - b2_re * s6
    d5_im = d5_im - b2_im * s6
    c5_re = c5_re + a3_re * c1
    c5_im = c5_im + a3_im * c1
    d5_re = d5_re - b3_re * s1
    d5_im = d5_im - b3_im * s1
    d5_re = d5_re + b4_re * s4
    d5_im = d5_im + b4_im * s4
    c5_re = c5_re + a5_re * c7
    c5_im = c5_im + a5_im * c7
    d5_re = d5_re - b5_re * s7
    d5_im = d5_im - b5_im * s7
    c5_re = c5_re + a6_re * c2
    c5_im = c5_im + a6_im * c2
    d5_re = d5_re - b6_re * s2
    d5_im = d5_im - b6_im * s2
    c5_re = c5_re + a7_re * c3
    c5_im = c5_im + a7_im * c3
    d5_re = d5_re + b7_re * s3
    d5_im = d5_im + b7_im * s3
    out5_re = c5_re + d5_im - v8_re
    out5_im = c5_im - d5_re - v8_im
    out11_re = c5_re - d5_im - v8_re
    out11_im = c5_im + d5_re - v8_im
    let mut out6_re = 0.0
    let mut out6_im = 0.0
    let mut out10_re = 0.0
    let mut out10_im = 0.0
    let mut c6_re = 0.0
    let mut c6_im = 0.0
    c6_re = v0_re
    c6_im = v0_im
    let mut d6_re = 0.0
    let mut d6_im = 0.0
    c6_re = c6_re + a1_re * c6
    c6_im = c6_im + a1_im * c6
    d6_re = d6_re + b1_re * s6
    d6_im = d6_im + b1_im * s6
    d6_re = d6_re - b2_re * s4
    d6_im = d6_im - b2_im * s4
    c6_re = c6_re + a3_re * c2
    c6_im = c6_im + a3_im * c2
    d6_re = d6_re + b3_re * s2
    d6_im = d6_im + b3_im * s2
    c6_re = c6_re - a4_re
    c6_im = c6_im - a4_im
    c6_re = c6_re + a5_re * c2
    c6_im = c6_im + a5_im * c2
    d6_re = d6_re - b5_re * s2
