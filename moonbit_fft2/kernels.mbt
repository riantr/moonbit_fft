    im[p1] = y1i + y6r
    re[p2] = y2r - y5i
    im[p2] = y2i + y5r
    re[p3] = y3r - y4i
    im[p3] = y3i + y4r
    re[p4] = y3r + y4i
    im[p4] = y3i - y4r
    re[p5] = y2r + y5i
    im[p5] = y2i - y5r
    re[p6] = y1r + y6i
    im[p6] = y1i - y6r
    if p0 < limit {
