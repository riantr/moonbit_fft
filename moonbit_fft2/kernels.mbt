    let y4i = c6 * t4i - c4 * t5i + c5 * t6i
    let y5r = c5 * t4r - c6 * t5r - c4 * t6r
    let y5i = c5 * t4i - c6 * t5i - c4 * t6i
    let y6r = c4 * t4r + c5 * t5r + c6 * t6r
    let y6i = c4 * t4i + c5 * t5i + c6 * t6i
    re[p0] = re[p0] + t1r + t2r + t3r
    im[p0] = im[p0] + t1i + t2i + t3i
    re[p1] = y1r - y6i
    im[p1] = y1i + y6r
    re[p2] = y2r - y5i
    im[p2] = y2i + y5r
    re[p3] = y3r - y4i
    im[p3] = y3i + y4r
    re[p4] = y3r + y4i
    im[p4] = y3i - y4r
    re[p5] = y2r + y5i
    im[p5] = y2i - y5r
    re[p6] = y1r + y6i
    im[p6] = y1i - y6r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 8 stage of the prime factor
/// transform, for the twist 1.
///
/// This is the small transform of the original, `Pfacc.pfa8`,
/// with the twist 1.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r8_mu1(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 8
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 8)
  let mut p1 = m * (1 * kfac % 8)
  let mut p2 = m * (2 * kfac % 8)
  let mut p3 = m * (3 * kfac % 8)
  let mut p4 = m * (4 * kfac % 8)
  let mut p5 = m * (5 * kfac % 8)
  let mut p6 = m * (6 * kfac % 8)
  let mut p7 = m * (7 * kfac % 8)
  let c1 = 0.9999999999999998
  let c2 = 0.7071067811865474
  let c3 = 0.7071067811865472
  let mut i = 0
  while i < m {
    let t1r = re[p0] + re[p4]
    let t1i = im[p0] + im[p4]
    let t2r = re[p0] - re[p4]
    let t2i = im[p0] - im[p4]
