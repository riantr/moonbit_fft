    let y10i = c6 * t6i + c7 * t7i + c8 * t8i + c9 * t9i + c10 * t10i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i
    re[p1] = y1r - y10i
    im[p1] = y1i + y10r
    re[p2] = y2r - y9i
    im[p2] = y2i + y9r
    re[p3] = y3r - y8i
    im[p3] = y3i + y8r
    re[p4] = y4r - y7i
    im[p4] = y4i + y7r
    re[p5] = y5r - y6i
