    im[p4] = y4i + y7r
    re[p5] = y5r - y6i
    im[p5] = y5i + y6r
    re[p6] = y5r + y6i
    im[p6] = y5i - y6r
    re[p7] = y4r + y7i
    im[p7] = y4i - y7r
    re[p8] = y3r + y8i
    im[p8] = y3i - y8r
    re[p9] = y2r + y9i
    im[p9] = y2i - y9r
    re[p10] = y1r + y10i
    im[p10] = y1i - y10r
    if p0 < limit {
