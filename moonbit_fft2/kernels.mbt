    let y10r = c6 * t6r + c7 * t7r + c8 * t8r + c9 * t9r + c10 * t10r
    let y10i = c6 * t6i + c7 * t7i + c8 * t8i + c9 * t9i + c10 * t10i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i
    re[p1] = y1r - y10i
    im[p1] = y1i + y10r
    re[p2] = y2r - y9i
    im[p2] = y2i + y9r
    re[p3] = y3r - y8i
    im[p3] = y3i + y8r
    re[p4] = y4r - y7i
    im[p4] = y4i + y7r
    re[p5] = y5r - y6i
    im[p5] = y5i + y6r
    re[p6] = y5r + y6i
    im[p6] = y5i - y6r
    re[p7] = y4r + y7i
    im[p7] = y4i - y7r
    re[p8] = y3r + y8i
    im[p8] = y3i - y8r
    re[p9] = y2r + y9i
    im[p9] = y2i - y9r
    re[p10] = y1r + y10i
    im[p10] = y1i - y10r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
