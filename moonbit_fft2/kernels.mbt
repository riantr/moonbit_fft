    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 11 stage of the prime factor
/// transform, for the twist 3.
///
/// This is the small transform of the original, `Pfacc.pfa11`,
/// with the twist 3.  Its constants are solved in double
