    out9_re = c7_re - d7_im - v8_re
    out9_im = c7_im + d7_re - v8_im
    re[p0] = out0_re
    im[p0] = out0_im
    re[p1] = out1_re
    im[p1] = out1_im
    re[p2] = out2_re
