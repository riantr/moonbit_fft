  let mut p10 = m * (10 * kfac % 11)
  let c1 = -0.14231483827328514
  let c2 = -0.9594929736144985
  let c3 = 0.4154150130018867
  let c4 = 0.8412535328311801
  let c5 = -0.6548607339452848
