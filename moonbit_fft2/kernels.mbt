  let c8 = -0.9096319953545182
  let c9 = 0.5406408174555988
  let c10 = 0.7557495743542588
  let mut i = 0
  while i < m {
    let t1r = re[p1] + re[p10]
    let t1i = im[p1] + im[p10]
    let t2r = re[p2] + re[p9]
    let t2i = im[p2] + im[p9]
