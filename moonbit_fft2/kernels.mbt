    let y4i = t13i + c4 * t14i + c5 * t15i + c1 * t16i + c3 * t17i + c6 * t18i
    let y5r = t13r + c5 * t14r + c3 * t15r + c2 * t16r + c6 * t17r + c1 * t18r
    let y5i = t13i + c5 * t14i + c3 * t15i + c2 * t16i + c6 * t17i + c1 * t18i
    let y6r = t13r + c6 * t14r + c1 * t15r + c5 * t16r + c2 * t17r + c4 * t18r
    let y6i = t13i + c6 * t14i + c1 * t15i + c5 * t16i + c2 * t17i + c4 * t18i
    let y7r = c12 * t7r -
      c7 * t8r +
      c11 * t9r -
      c8 * t10r +
      c10 * t11r -
      c9 * t12r
    let y7i = c12 * t7i -
      c7 * t8i +
      c11 * t9i -
      c8 * t10i +
      c10 * t11i -
      c9 * t12i
    let y8r = c11 * t7r -
      c9 * t8r +
      c8 * t9r -
      c12 * t10r -
      c7 * t11r +
      c10 * t12r
    let y8i = c11 * t7i -
      c9 * t8i +
      c8 * t9i -
      c12 * t10i -
      c7 * t11i +
      c10 * t12i
    let y9r = c10 * t7r -
      c11 * t8r -
      c7 * t9r +
      c9 * t10r -
      c12 * t11r -
      c8 * t12r
    let y9i = c10 * t7i -
      c11 * t8i -
      c7 * t9i +
      c9 * t10i -
      c12 * t11i -
      c8 * t12i
    let y10r = c9 * t7r +
      c12 * t8r -
      c10 * t9r -
      c7 * t10r +
      c8 * t11r +
      c11 * t12r
    let y10i = c9 * t7i +
      c12 * t8i -
      c10 * t9i -
      c7 * t10i +
      c8 * t11i +
      c11 * t12i
    let y11r = c8 * t7r +
      c10 * t8r +
      c12 * t9r -
      c11 * t10r -
      c9 * t11r -
      c7 * t12r
    let y11i = c8 * t7i +
      c10 * t8i +
      c12 * t9i -
      c11 * t10i -
      c9 * t11i -
      c7 * t12i
    let y12r = c7 * t7r +
      c8 * t8r +
      c9 * t9r +
      c10 * t10r +
      c11 * t11r +
      c12 * t12r
    let y12i = c7 * t7i +
      c8 * t8i +
      c9 * t9i +
      c10 * t10i +
      c11 * t11i +
      c12 * t12i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r + t6r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i + t6i
    re[p1] = y1r - y12i
    im[p1] = y1i + y12r
    re[p2] = y2r - y11i
    im[p2] = y2i + y11r
    re[p3] = y3r - y10i
    im[p3] = y3i + y10r
    re[p4] = y4r - y9i
    im[p4] = y4i + y9r
    re[p5] = y5r - y8i
    im[p5] = y5i + y8r
    re[p6] = y6r - y7i
    im[p6] = y6i + y7r
    re[p7] = y6r + y7i
    im[p7] = y6i - y7r
    re[p8] = y5r + y8i
    im[p8] = y5i - y8r
    re[p9] = y4r + y9i
    im[p9] = y4i - y9r
    re[p10] = y3r + y10i
    im[p10] = y3i - y10r
    re[p11] = y2r + y11i
    im[p11] = y2i - y11r
    re[p12] = y1r + y12i
    im[p12] = y1i - y12r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    if p11 < limit {
      p11 = p11 + mr
    }
    p11 = p11 + delta
    if p12 < limit {
      p12 = p12 + mr
    }
    p12 = p12 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 13 stage of the prime factor
/// transform, for the twist 2.
///
/// This is the small transform of the original, `Pfacc.pfa13`,
/// with the twist 2.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r13_mu2(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 13
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 13)
  let mut p1 = m * (1 * kfac % 13)
  let mut p2 = m * (2 * kfac % 13)
  let mut p3 = m * (3 * kfac % 13)
  let mut p4 = m * (4 * kfac % 13)
  let mut p5 = m * (5 * kfac % 13)
  let mut p6 = m * (6 * kfac % 13)
  let mut p7 = m * (7 * kfac % 13)
  let mut p8 = m * (8 * kfac % 13)
  let mut p9 = m * (9 * kfac % 13)
  let mut p10 = m * (10 * kfac % 13)
  let mut p11 = m * (11 * kfac % 13)
  let mut p12 = m * (12 * kfac % 13)
  let c1 = 0.5680647467311563
  let c2 = -0.3546048870425348
  let c3 = -0.9709418174260527
  let c4 = -0.7485107481711026
  let c5 = 0.1205366802553231
  let c6 = 0.8854560256532107
  let c7 = 0.8229838658936565
  let c8 = 0.9350162426854152
  let c9 = 0.2393156642875578
  let c10 = -0.6631226582407937
  let c11 = -0.9927088740980541
  let c12 = -0.4647231720437686
  let mut i = 0
  while i < m {
    let t1r = re[p1] + re[p12]
    let t1i = im[p1] + im[p12]
    let t2r = re[p2] + re[p11]
    let t2i = im[p2] + im[p11]
    let t3r = re[p3] + re[p10]
    let t3i = im[p3] + im[p10]
    let t4r = re[p4] + re[p9]
    let t4i = im[p4] + im[p9]
    let t5r = re[p5] + re[p8]
    let t5i = im[p5] + im[p8]
    let t6r = re[p6] + re[p7]
    let t6i = im[p6] + im[p7]
    let t7r = re[p1] - re[p12]
    let t7i = im[p1] - im[p12]
    let t8r = re[p2] - re[p11]
    let t8i = im[p2] - im[p11]
    let t9r = re[p3] - re[p10]
    let t9i = im[p3] - im[p10]
    let t10r = re[p4] - re[p9]
    let t10i = im[p4] - im[p9]
    let t11r = re[p5] - re[p8]
    let t11i = im[p5] - im[p8]
    let t12r = re[p6] - re[p7]
    let t12i = im[p6] - im[p7]
    let t13r = re[p0] - 0.5 * t6r
    let t13i = im[p0] - 0.5 * t6i
    let t14r = t1r - t6r
    let t14i = t1i - t6i
    let t15r = t2r - t6r
    let t15i = t2i - t6i
    let t16r = t3r - t6r
    let t16i = t3i - t6i
    let t17r = t4r - t6r
    let t17i = t4i - t6i
    let t18r = t5r - t6r
    let t18i = t5i - t6i
    let y1r = t13r + c1 * t14r + c2 * t15r + c3 * t16r + c4 * t17r + c5 * t18r
    let y1i = t13i + c1 * t14i + c2 * t15i + c3 * t16i + c4 * t17i + c5 * t18i
    let y2r = t13r + c2 * t14r + c4 * t15r + c6 * t16r + c5 * t17r + c3 * t18r
    let y2i = t13i + c2 * t14i + c4 * t15i + c6 * t16i + c5 * t17i + c3 * t18i
    let y3r = t13r + c3 * t14r + c6 * t15r + c4 * t16r + c1 * t17r + c2 * t18r
    let y3i = t13i + c3 * t14i + c6 * t15i + c4 * t16i + c1 * t17i + c2 * t18i
    let y4r = t13r + c4 * t14r + c5 * t15r + c1 * t16r + c3 * t17r + c6 * t18r
    let y4i = t13i + c4 * t14i + c5 * t15i + c1 * t16i + c3 * t17i + c6 * t18i
    let y5r = t13r + c5 * t14r + c3 * t15r + c2 * t16r + c6 * t17r + c1 * t18r
    let y5i = t13i + c5 * t14i + c3 * t15i + c2 * t16i + c6 * t17i + c1 * t18i
    let y6r = t13r + c6 * t14r + c1 * t15r + c5 * t16r + c2 * t17r + c4 * t18r
    let y6i = t13i + c6 * t14i + c1 * t15i + c5 * t16i + c2 * t17i + c4 * t18i
    let y7r = c12 * t7r -
      c7 * t8r +
      c11 * t9r -
      c8 * t10r +
      c10 * t11r -
      c9 * t12r
    let y7i = c12 * t7i -
      c7 * t8i +
      c11 * t9i -
      c8 * t10i +
      c10 * t11i -
      c9 * t12i
    let y8r = c11 * t7r -
      c9 * t8r +
      c8 * t9r -
      c12 * t10r -
      c7 * t11r +
      c10 * t12r
    let y8i = c11 * t7i -
      c9 * t8i +
      c8 * t9i -
      c12 * t10i -
      c7 * t11i +
      c10 * t12i
    let y9r = c10 * t7r -
      c11 * t8r -
      c7 * t9r +
      c9 * t10r -
      c12 * t11r -
      c8 * t12r
    let y9i = c10 * t7i -
      c11 * t8i -
      c7 * t9i +
      c9 * t10i -
      c12 * t11i -
      c8 * t12i
    let y10r = c9 * t7r +
      c12 * t8r -
      c10 * t9r -
      c7 * t10r +
      c8 * t11r +
      c11 * t12r
    let y10i = c9 * t7i +
      c12 * t8i -
      c10 * t9i -
      c7 * t10i +
      c8 * t11i +
      c11 * t12i
    let y11r = c8 * t7r +
      c10 * t8r +
      c12 * t9r -
      c11 * t10r -
      c9 * t11r -
      c7 * t12r
    let y11i = c8 * t7i +
      c10 * t8i +
      c12 * t9i -
      c11 * t10i -
      c9 * t11i -
      c7 * t12i
    let y12r = c7 * t7r +
      c8 * t8r +
      c9 * t9r +
      c10 * t10r +
      c11 * t11r +
      c12 * t12r
    let y12i = c7 * t7i +
      c8 * t8i +
      c9 * t9i +
      c10 * t10i +
      c11 * t11i +
      c12 * t12i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r + t6r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i + t6i
    re[p1] = y1r - y12i
    im[p1] = y1i + y12r
    re[p2] = y2r - y11i
    im[p2] = y2i + y11r
    re[p3] = y3r - y10i
    im[p3] = y3i + y10r
    re[p4] = y4r - y9i
    im[p4] = y4i + y9r
    re[p5] = y5r - y8i
    im[p5] = y5i + y8r
    re[p6] = y6r - y7i
    im[p6] = y6i + y7r
    re[p7] = y6r + y7i
    im[p7] = y6i - y7r
    re[p8] = y5r + y8i
    im[p8] = y5i - y8r
    re[p9] = y4r + y9i
    im[p9] = y4i - y9r
    re[p10] = y3r + y10i
    im[p10] = y3i - y10r
    re[p11] = y2r + y11i
    im[p11] = y2i - y11r
    re[p12] = y1r + y12i
    im[p12] = y1i - y12r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    if p11 < limit {
      p11 = p11 + mr
    }
    p11 = p11 + delta
    if p12 < limit {
      p12 = p12 + mr
    }
    p12 = p12 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 13 stage of the prime factor
/// transform, for the twist 3.
///
/// This is the small transform of the original, `Pfacc.pfa13`,
/// with the twist 3.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r13_mu3(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 13
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 13)
  let mut p1 = m * (1 * kfac % 13)
  let mut p2 = m * (2 * kfac % 13)
  let mut p3 = m * (3 * kfac % 13)
  let mut p4 = m * (4 * kfac % 13)
  let mut p5 = m * (5 * kfac % 13)
  let mut p6 = m * (6 * kfac % 13)
  let mut p7 = m * (7 * kfac % 13)
  let mut p8 = m * (8 * kfac % 13)
  let mut p9 = m * (9 * kfac % 13)
  let mut p10 = m * (10 * kfac % 13)
  let mut p11 = m * (11 * kfac % 13)
  let mut p12 = m * (12 * kfac % 13)
  let c1 = 0.12053668025532313
  let c2 = -0.9709418174260512
  let c3 = -0.35460488704253595
  let c4 = 0.8854560256532102
  let c5 = 0.5680647467311561
  let c6 = -0.7485107481711026
  let c7 = 0.992708874098054
  let c8 = 0.2393156642875576
  let c9 = -0.9350162426854149
  let c10 = -0.46472317204376734
  let c11 = 0.8229838658936562
  let c12 = 0.6631226582407944
  let mut i = 0
  while i < m {
    let t1r = re[p1] + re[p12]
    let t1i = im[p1] + im[p12]
    let t2r = re[p2] + re[p11]
    let t2i = im[p2] + im[p11]
    let t3r = re[p3] + re[p10]
    let t3i = im[p3] + im[p10]
    let t4r = re[p4] + re[p9]
    let t4i = im[p4] + im[p9]
    let t5r = re[p5] + re[p8]
    let t5i = im[p5] + im[p8]
    let t6r = re[p6] + re[p7]
    let t6i = im[p6] + im[p7]
    let t7r = re[p1] - re[p12]
    let t7i = im[p1] - im[p12]
    let t8r = re[p2] - re[p11]
    let t8i = im[p2] - im[p11]
    let t9r = re[p3] - re[p10]
    let t9i = im[p3] - im[p10]
    let t10r = re[p4] - re[p9]
    let t10i = im[p4] - im[p9]
    let t11r = re[p5] - re[p8]
    let t11i = im[p5] - im[p8]
    let t12r = re[p6] - re[p7]
    let t12i = im[p6] - im[p7]
    let t13r = re[p0] - 0.5 * t6r
    let t13i = im[p0] - 0.5 * t6i
    let t14r = t1r - t6r
    let t14i = t1i - t6i
    let t15r = t2r - t6r
    let t15i = t2i - t6i
    let t16r = t3r - t6r
    let t16i = t3i - t6i
    let t17r = t4r - t6r
    let t17i = t4i - t6i
    let t18r = t5r - t6r
    let t18i = t5i - t6i
    let y1r = t13r + c1 * t14r + c2 * t15r + c3 * t16r + c4 * t17r + c5 * t18r
    let y1i = t13i + c1 * t14i + c2 * t15i + c3 * t16i + c4 * t17i + c5 * t18i
    let y2r = t13r + c2 * t14r + c4 * t15r + c6 * t16r + c5 * t17r + c3 * t18r
    let y2i = t13i + c2 * t14i + c4 * t15i + c6 * t16i + c5 * t17i + c3 * t18i
    let y3r = t13r + c3 * t14r + c6 * t15r + c4 * t16r + c1 * t17r + c2 * t18r
    let y3i = t13i + c3 * t14i + c6 * t15i + c4 * t16i + c1 * t17i + c2 * t18i
    let y4r = t13r + c4 * t14r + c5 * t15r + c1 * t16r + c3 * t17r + c6 * t18r
    let y4i = t13i + c4 * t14i + c5 * t15i + c1 * t16i + c3 * t17i + c6 * t18i
    let y5r = t13r + c5 * t14r + c3 * t15r + c2 * t16r + c6 * t17r + c1 * t18r
    let y5i = t13i + c5 * t14i + c3 * t15i + c2 * t16i + c6 * t17i + c1 * t18i
    let y6r = t13r + c6 * t14r + c1 * t15r + c5 * t16r + c2 * t17r + c4 * t18r
    let y6i = t13i + c6 * t14i + c1 * t15i + c5 * t16i + c2 * t17i + c4 * t18i
    let y7r = c12 * t7r -
      c7 * t8r +
      c11 * t9r -
      c8 * t10r +
      c10 * t11r -
      c9 * t12r
    let y7i = c12 * t7i -
      c7 * t8i +
      c11 * t9i -
      c8 * t10i +
      c10 * t11i -
      c9 * t12i
    let y8r = c11 * t7r -
      c9 * t8r +
      c8 * t9r -
      c12 * t10r -
      c7 * t11r +
      c10 * t12r
    let y8i = c11 * t7i -
      c9 * t8i +
      c8 * t9i -
      c12 * t10i -
      c7 * t11i +
      c10 * t12i
    let y9r = c10 * t7r -
      c11 * t8r -
      c7 * t9r +
      c9 * t10r -
      c12 * t11r -
      c8 * t12r
    let y9i = c10 * t7i -
      c11 * t8i -
      c7 * t9i +
      c9 * t10i -
      c12 * t11i -
      c8 * t12i
    let y10r = c9 * t7r +
      c12 * t8r -
      c10 * t9r -
      c7 * t10r +
      c8 * t11r +
      c11 * t12r
    let y10i = c9 * t7i +
      c12 * t8i -
      c10 * t9i -
      c7 * t10i +
      c8 * t11i +
      c11 * t12i
    let y11r = c8 * t7r +
      c10 * t8r +
      c12 * t9r -
      c11 * t10r -
      c9 * t11r -
      c7 * t12r
    let y11i = c8 * t7i +
      c10 * t8i +
      c12 * t9i -
      c11 * t10i -
      c9 * t11i -
      c7 * t12i
    let y12r = c7 * t7r +
      c8 * t8r +
      c9 * t9r +
      c10 * t10r +
      c11 * t11r +
      c12 * t12r
    let y12i = c7 * t7i +
      c8 * t8i +
      c9 * t9i +
      c10 * t10i +
      c11 * t11i +
      c12 * t12i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r + t6r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i + t6i
    re[p1] = y1r - y12i
    im[p1] = y1i + y12r
    re[p2] = y2r - y11i
    im[p2] = y2i + y11r
    re[p3] = y3r - y10i
    im[p3] = y3i + y10r
    re[p4] = y4r - y9i
    im[p4] = y4i + y9r
    re[p5] = y5r - y8i
    im[p5] = y5i + y8r
    re[p6] = y6r - y7i
    im[p6] = y6i + y7r
    re[p7] = y6r + y7i
    im[p7] = y6i - y7r
    re[p8] = y5r + y8i
    im[p8] = y5i - y8r
    re[p9] = y4r + y9i
    im[p9] = y4i - y9r
    re[p10] = y3r + y10i
    im[p10] = y3i - y10r
    re[p11] = y2r + y11i
    im[p11] = y2i - y11r
    re[p12] = y1r + y12i
    im[p12] = y1i - y12r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    if p11 < limit {
      p11 = p11 + mr
    }
    p11 = p11 + delta
    if p12 < limit {
      p12 = p12 + mr
    }
    p12 = p12 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 13 stage of the prime factor
/// transform, for the twist 4.
///
/// This is the small transform of the original, `Pfacc.pfa13`,
/// with the twist 4.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r13_mu4(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 13
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 13)
  let mut p1 = m * (1 * kfac % 13)
  let mut p2 = m * (2 * kfac % 13)
  let mut p3 = m * (3 * kfac % 13)
  let mut p4 = m * (4 * kfac % 13)
  let mut p5 = m * (5 * kfac % 13)
  let mut p6 = m * (6 * kfac % 13)
  let mut p7 = m * (7 * kfac % 13)
  let mut p8 = m * (8 * kfac % 13)
  let mut p9 = m * (9 * kfac % 13)
  let mut p10 = m * (10 * kfac % 13)
  let mut p11 = m * (11 * kfac % 13)
  let mut p12 = m * (12 * kfac % 13)
  let c1 = -0.35460488704253584
  let c2 = -0.7485107481711042
  let c3 = 0.8854560256532105
  let c4 = 0.12053668025532638
  let c5 = -0.9709418174260527
  let c6 = 0.5680647467311561
  let c7 = 0.935016242685415
  let c8 = -0.6631226582407937
  let c9 = -0.4647231720437686
  let c10 = 0.9927088740980536
  let c11 = -0.23931566428755838
  let c12 = -0.8229838658936565
  let mut i = 0
  while i < m {
    let t1r = re[p1] + re[p12]
    let t1i = im[p1] + im[p12]
    let t2r = re[p2] + re[p11]
    let t2i = im[p2] + im[p11]
    let t3r = re[p3] + re[p10]
    let t3i = im[p3] + im[p10]
    let t4r = re[p4] + re[p9]
    let t4i = im[p4] + im[p9]
    let t5r = re[p5] + re[p8]
    let t5i = im[p5] + im[p8]
    let t6r = re[p6] + re[p7]
    let t6i = im[p6] + im[p7]
    let t7r = re[p1] - re[p12]
    let t7i = im[p1] - im[p12]
    let t8r = re[p2] - re[p11]
    let t8i = im[p2] - im[p11]
    let t9r = re[p3] - re[p10]
    let t9i = im[p3] - im[p10]
    let t10r = re[p4] - re[p9]
    let t10i = im[p4] - im[p9]
    let t11r = re[p5] - re[p8]
    let t11i = im[p5] - im[p8]
    let t12r = re[p6] - re[p7]
    let t12i = im[p6] - im[p7]
    let t13r = re[p0] - 0.5 * t6r
    let t13i = im[p0] - 0.5 * t6i
    let t14r = t1r - t6r
    let t14i = t1i - t6i
    let t15r = t2r - t6r
    let t15i = t2i - t6i
    let t16r = t3r - t6r
    let t16i = t3i - t6i
    let t17r = t4r - t6r
    let t17i = t4i - t6i
    let t18r = t5r - t6r
    let t18i = t5i - t6i
    let y1r = t13r + c1 * t14r + c2 * t15r + c3 * t16r + c4 * t17r + c5 * t18r
    let y1i = t13i + c1 * t14i + c2 * t15i + c3 * t16i + c4 * t17i + c5 * t18i
    let y2r = t13r + c2 * t14r + c4 * t15r + c6 * t16r + c5 * t17r + c3 * t18r
    let y2i = t13i + c2 * t14i + c4 * t15i + c6 * t16i + c5 * t17i + c3 * t18i
    let y3r = t13r + c3 * t14r + c6 * t15r + c4 * t16r + c1 * t17r + c2 * t18r
    let y3i = t13i + c3 * t14i + c6 * t15i + c4 * t16i + c1 * t17i + c2 * t18i
    let y4r = t13r + c4 * t14r + c5 * t15r + c1 * t16r + c3 * t17r + c6 * t18r
    let y4i = t13i + c4 * t14i + c5 * t15i + c1 * t16i + c3 * t17i + c6 * t18i
    let y5r = t13r + c5 * t14r + c3 * t15r + c2 * t16r + c6 * t17r + c1 * t18r
    let y5i = t13i + c5 * t14i + c3 * t15i + c2 * t16i + c6 * t17i + c1 * t18i
    let y6r = t13r + c6 * t14r + c1 * t15r + c5 * t16r + c2 * t17r + c4 * t18r
    let y6i = t13i + c6 * t14i + c1 * t15i + c5 * t16i + c2 * t17i + c4 * t18i
    let y7r = c12 * t7r -
      c7 * t8r +
      c11 * t9r -
      c8 * t10r +
      c10 * t11r -
      c9 * t12r
    let y7i = c12 * t7i -
      c7 * t8i +
      c11 * t9i -
      c8 * t10i +
      c10 * t11i -
      c9 * t12i
    let y8r = c11 * t7r -
      c9 * t8r +
      c8 * t9r -
      c12 * t10r -
      c7 * t11r +
      c10 * t12r
    let y8i = c11 * t7i -
      c9 * t8i +
      c8 * t9i -
      c12 * t10i -
      c7 * t11i +
      c10 * t12i
    let y9r = c10 * t7r -
      c11 * t8r -
      c7 * t9r +
      c9 * t10r -
      c12 * t11r -
      c8 * t12r
    let y9i = c10 * t7i -
      c11 * t8i -
      c7 * t9i +
      c9 * t10i -
      c12 * t11i -
      c8 * t12i
    let y10r = c9 * t7r +
      c12 * t8r -
      c10 * t9r -
      c7 * t10r +
      c8 * t11r +
      c11 * t12r
    let y10i = c9 * t7i +
      c12 * t8i -
      c10 * t9i -
      c7 * t10i +
      c8 * t11i +
      c11 * t12i
    let y11r = c8 * t7r +
      c10 * t8r +
      c12 * t9r -
      c11 * t10r -
      c9 * t11r -
      c7 * t12r
    let y11i = c8 * t7i +
      c10 * t8i +
      c12 * t9i -
      c11 * t10i -
      c9 * t11i -
      c7 * t12i
    let y12r = c7 * t7r +
      c8 * t8r +
      c9 * t9r +
      c10 * t10r +
      c11 * t11r +
      c12 * t12r
    let y12i = c7 * t7i +
      c8 * t8i +
      c9 * t9i +
      c10 * t10i +
      c11 * t11i +
      c12 * t12i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r + t6r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i + t6i
    re[p1] = y1r - y12i
    im[p1] = y1i + y12r
    re[p2] = y2r - y11i
    im[p2] = y2i + y11r
    re[p3] = y3r - y10i
    im[p3] = y3i + y10r
    re[p4] = y4r - y9i
    im[p4] = y4i + y9r
    re[p5] = y5r - y8i
    im[p5] = y5i + y8r
    re[p6] = y6r - y7i
    im[p6] = y6i + y7r
    re[p7] = y6r + y7i
    im[p7] = y6i - y7r
    re[p8] = y5r + y8i
    im[p8] = y5i - y8r
    re[p9] = y4r + y9i
    im[p9] = y4i - y9r
    re[p10] = y3r + y10i
    im[p10] = y3i - y10r
    re[p11] = y2r + y11i
    im[p11] = y2i - y11r
    re[p12] = y1r + y12i
    im[p12] = y1i - y12r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    if p11 < limit {
      p11 = p11 + mr
    }
    p11 = p11 + delta
    if p12 < limit {
      p12 = p12 + mr
    }
    p12 = p12 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 13 stage of the prime factor
/// transform, for the twist 5.
///
/// This is the small transform of the original, `Pfacc.pfa13`,
/// with the twist 5.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r13_mu5(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 13
  let delta = 1 - m * kfac
