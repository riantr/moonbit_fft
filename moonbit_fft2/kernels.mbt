    re[p2] = y2r - y6i
    im[p2] = y2i + y6r
    re[p3] = y3r - y5i
    im[p3] = y3i + y5r
    re[p4] = t9r - t10r
    im[p4] = t9i - t10i
    re[p5] = y3r + y5i
    im[p5] = y3i - y5r
    re[p6] = y2r + y6i
