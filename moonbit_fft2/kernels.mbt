    let t3i = im[p3] + im[p10]
    let t4r = re[p4] + re[p9]
    let t4i = im[p4] + im[p9]
    let t5r = re[p5] + re[p8]
    let t5i = im[p5] + im[p8]
    let t6r = re[p6] + re[p7]
    let t6i = im[p6] + im[p7]
    let t7r = re[p1] - re[p12]
    let t7i = im[p1] - im[p12]
