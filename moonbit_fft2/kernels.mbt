    let t6i = im[p1] - im[p10]
    let t7r = re[p2] - re[p9]
    let t7i = im[p2] - im[p9]
    let t8r = re[p3] - re[p8]
    let t8i = im[p3] - im[p8]
    let t9r = re[p4] - re[p7]
    let t9i = im[p4] - im[p7]
    let t10r = re[p5] - re[p6]
    let t10i = im[p5] - im[p6]
    let t11r = re[p0] - 0.5 * t5r
    let t11i = im[p0] - 0.5 * t5i
