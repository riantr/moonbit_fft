    let t2r = re[p0] - 0.5 * t1r
    let t2i = im[p0] - 0.5 * t1i
    let t3r = c1 * (re[p3] - re[p6])
    let t3i = c1 * (im[p3] - im[p6])
    let t4r = re[p0] + t1r
    let t4i = im[p0] + t1i
    let t5r = re[p4] + re[p7]
    let t5i = im[p4] + im[p7]
    let t6r = re[p1] - 0.5 * t5r
    let t6i = im[p1] - 0.5 * t5i
    let t7r = re[p4] - re[p7]
    let t7i = im[p4] - im[p7]
    let t8r = re[p1] + t5r
    let t8i = im[p1] + t5i
    let t9r = re[p2] + re[p5]
    let t9i = im[p2] + im[p5]
    let t10r = re[p8] - 0.5 * t9r
    let t10i = im[p8] - 0.5 * t9i
    let t11r = re[p2] - re[p5]
    let t11i = im[p2] - im[p5]
    let t12r = re[p8] + t9r
    let t12i = im[p8] + t9i
    let t13r = t8r + t12r
    let t13i = t8i + t12i
    let t14r = t6r + t10r
    let t14i = t6i + t10i
    let t15r = t6r - t10r
    let t15i = t6i - t10i
    let t16r = t7r + t11r
    let t16i = t7i + t11i
    let t17r = t7r - t11r
    let t17i = t7i - t11i
    let t18r = c2 * t14r - c7 * t17r
    let t18i = c2 * t14i - c7 * t17i
    let t19r = c4 * t14r + c9 * t17r
    let t19i = c4 * t14i + c9 * t17i
    let t20r = c3 * t15r + c6 * t16r
    let t20i = c3 * t15i + c6 * t16i
    let t21r = c5 * t15r - c8 * t16r
    let t21i = c5 * t15i - c8 * t16i
    let t22r = t18r + t19r
    let t22i = t18i + t19i
    let t23r = t20r - t21r
    let t23i = t20i - t21i
    let y1r = t2r + t18r
    let y1i = t2i + t18i
    let y2r = t2r + t19r
    let y2i = t2i + t19i
    let y3r = t4r - 0.5 * t13r
    let y3i = t4i - 0.5 * t13i
    let y4r = t2r - t22r
    let y4i = t2i - t22i
    let y5r = t3r - t23r
    let y5i = t3i - t23i
    let y6r = c1 * (t8r - t12r)
    let y6i = c1 * (t8i - t12i)
    let y7r = t21r - t3r
    let y7i = t21i - t3i
    let y8r = t3r + t20r
    let y8i = t3i + t20i
    re[p0] = t4r + t13r
    im[p0] = t4i + t13i
    re[p1] = y1r - y8i
    im[p1] = y1i + y8r
    re[p2] = y2r - y7i
    im[p2] = y2i + y7r
    re[p3] = y3r - y6i
    im[p3] = y3i + y6r
    re[p4] = y4r - y5i
    im[p4] = y4i + y5r
    re[p5] = y4r + y5i
    im[p5] = y4i - y5r
    re[p6] = y3r + y6i
    im[p6] = y3i - y6r
    re[p7] = y2r + y7i
    im[p7] = y2i - y7r
    re[p8] = y1r + y8i
    im[p8] = y1i - y8r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 9 stage of the prime factor
/// transform, for the twist 8.
///
/// This is the small transform of the original, `Pfacc.pfa9`,
/// with the twist 8.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r9_mu8(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 9
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 9)
  let mut p1 = m * (1 * kfac % 9)
  let mut p2 = m * (2 * kfac % 9)
  let mut p3 = m * (3 * kfac % 9)
  let mut p4 = m * (4 * kfac % 9)
  let mut p5 = m * (5 * kfac % 9)
  let mut p6 = m * (6 * kfac % 9)
  let mut p7 = m * (7 * kfac % 9)
  let mut p8 = m * (8 * kfac % 9)
  let c1 = -0.8660254037844377
  let c2 = 0.7660444431189781
  let c3 = -0.6427876096865405
  let c4 = 0.17364817766692886
  let c5 = -0.9848077530122081
  let c6 = -0.6634139481689377
  let c7 = 0.5566703992264198
  let c8 = -0.15038373318043385
  let c9 = 0.8528685319524424
  let mut i = 0
  while i < m {
    let t1r = re[p3] + re[p6]
    let t1i = im[p3] + im[p6]
    let t2r = re[p0] - 0.5 * t1r
    let t2i = im[p0] - 0.5 * t1i
    let t3r = c1 * (re[p3] - re[p6])
    let t3i = c1 * (im[p3] - im[p6])
    let t4r = re[p0] + t1r
    let t4i = im[p0] + t1i
    let t5r = re[p4] + re[p7]
    let t5i = im[p4] + im[p7]
    let t6r = re[p1] - 0.5 * t5r
    let t6i = im[p1] - 0.5 * t5i
    let t7r = re[p4] - re[p7]
    let t7i = im[p4] - im[p7]
    let t8r = re[p1] + t5r
    let t8i = im[p1] + t5i
    let t9r = re[p2] + re[p5]
    let t9i = im[p2] + im[p5]
    let t10r = re[p8] - 0.5 * t9r
    let t10i = im[p8] - 0.5 * t9i
    let t11r = re[p2] - re[p5]
    let t11i = im[p2] - im[p5]
    let t12r = re[p8] + t9r
    let t12i = im[p8] + t9i
    let t13r = t8r + t12r
    let t13i = t8i + t12i
    let t14r = t6r + t10r
    let t14i = t6i + t10i
    let t15r = t6r - t10r
    let t15i = t6i - t10i
    let t16r = t7r + t11r
    let t16i = t7i + t11i
    let t17r = t7r - t11r
    let t17i = t7i - t11i
    let t18r = c2 * t14r - c7 * t17r
    let t18i = c2 * t14i - c7 * t17i
    let t19r = c4 * t14r + c9 * t17r
    let t19i = c4 * t14i + c9 * t17i
    let t20r = c3 * t15r + c6 * t16r
    let t20i = c3 * t15i + c6 * t16i
    let t21r = c5 * t15r - c8 * t16r
    let t21i = c5 * t15i - c8 * t16i
    let t22r = t18r + t19r
    let t22i = t18i + t19i
    let t23r = t20r - t21r
    let t23i = t20i - t21i
    let y1r = t2r + t18r
    let y1i = t2i + t18i
    let y2r = t2r + t19r
    let y2i = t2i + t19i
    let y3r = t4r - 0.5 * t13r
    let y3i = t4i - 0.5 * t13i
    let y4r = t2r - t22r
    let y4i = t2i - t22i
    let y5r = t3r - t23r
    let y5i = t3i - t23i
    let y6r = c1 * (t8r - t12r)
    let y6i = c1 * (t8i - t12i)
    let y7r = t21r - t3r
    let y7i = t21i - t3i
    let y8r = t3r + t20r
    let y8i = t3i + t20i
    re[p0] = t4r + t13r
    im[p0] = t4i + t13i
    re[p1] = y1r - y8i
    im[p1] = y1i + y8r
    re[p2] = y2r - y7i
    im[p2] = y2i + y7r
    re[p3] = y3r - y6i
    im[p3] = y3i + y6r
    re[p4] = y4r - y5i
    im[p4] = y4i + y5r
    re[p5] = y4r + y5i
    im[p5] = y4i - y5r
    re[p6] = y3r + y6i
    im[p6] = y3i - y6r
    re[p7] = y2r + y7i
    im[p7] = y2i - y7r
    re[p8] = y1r + y8i
    im[p8] = y1i - y8r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 11 stage of the prime factor
/// transform, for the twist 1.
///
/// This is the small transform of the original, `Pfacc.pfa11`,
/// with the twist 1.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r11_mu1(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 11
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 11)
  let mut p1 = m * (1 * kfac % 11)
  let mut p2 = m * (2 * kfac % 11)
  let mut p3 = m * (3 * kfac % 11)
  let mut p4 = m * (4 * kfac % 11)
  let mut p5 = m * (5 * kfac % 11)
  let mut p6 = m * (6 * kfac % 11)
  let mut p7 = m * (7 * kfac % 11)
  let mut p8 = m * (8 * kfac % 11)
  let mut p9 = m * (9 * kfac % 11)
  let mut p10 = m * (10 * kfac % 11)
  let c1 = 0.8412535328311812
  let c2 = 0.41541501300188655
  let c3 = -0.14231483827328537
  let c4 = -0.6548607339452844
  let c5 = -0.9594929736144978
  let c6 = 0.5406408174555972
  let c7 = 0.909631995354518
  let c8 = 0.9898214418809327
  let c9 = 0.7557495743542586
  let c10 = 0.28173255684143006
  let mut i = 0
  while i < m {
    let t1r = re[p1] + re[p10]
    let t1i = im[p1] + im[p10]
    let t2r = re[p2] + re[p9]
    let t2i = im[p2] + im[p9]
    let t3r = re[p3] + re[p8]
    let t3i = im[p3] + im[p8]
    let t4r = re[p4] + re[p7]
    let t4i = im[p4] + im[p7]
    let t5r = re[p5] + re[p6]
    let t5i = im[p5] + im[p6]
    let t6r = re[p1] - re[p10]
    let t6i = im[p1] - im[p10]
    let t7r = re[p2] - re[p9]
    let t7i = im[p2] - im[p9]
    let t8r = re[p3] - re[p8]
    let t8i = im[p3] - im[p8]
    let t9r = re[p4] - re[p7]
    let t9i = im[p4] - im[p7]
    let t10r = re[p5] - re[p6]
    let t10i = im[p5] - im[p6]
    let t11r = re[p0] - 0.5 * t5r
    let t11i = im[p0] - 0.5 * t5i
    let t12r = t1r - t5r
    let t12i = t1i - t5i
    let t13r = t2r - t5r
    let t13i = t2i - t5i
    let t14r = t3r - t5r
    let t14i = t3i - t5i
    let t15r = t4r - t5r
    let t15i = t4i - t5i
    let y1r = t11r + c1 * t12r + c2 * t13r + c3 * t14r + c4 * t15r
    let y1i = t11i + c1 * t12i + c2 * t13i + c3 * t14i + c4 * t15i
    let y2r = t11r + c2 * t12r + c4 * t13r + c5 * t14r + c3 * t15r
    let y2i = t11i + c2 * t12i + c4 * t13i + c5 * t14i + c3 * t15i
    let y3r = t11r + c3 * t12r + c5 * t13r + c2 * t14r + c1 * t15r
    let y3i = t11i + c3 * t12i + c5 * t13i + c2 * t14i + c1 * t15i
    let y4r = t11r + c4 * t12r + c3 * t13r + c1 * t14r + c5 * t15r
    let y4i = t11i + c4 * t12i + c3 * t13i + c1 * t14i + c5 * t15i
    let y5r = t11r + c5 * t12r + c1 * t13r + c4 * t14r + c2 * t15r
    let y5i = t11i + c5 * t12i + c1 * t13i + c4 * t14i + c2 * t15i
    let y6r = c10 * t6r - c6 * t7r + c9 * t8r - c7 * t9r + c8 * t10r
    let y6i = c10 * t6i - c6 * t7i + c9 * t8i - c7 * t9i + c8 * t10i
    let y7r = c9 * t6r - c8 * t7r + c6 * t8r + c10 * t9r - c7 * t10r
    let y7i = c9 * t6i - c8 * t7i + c6 * t8i + c10 * t9i - c7 * t10i
    let y8r = c8 * t6r - c10 * t7r - c7 * t8r + c6 * t9r + c9 * t10r
    let y8i = c8 * t6i - c10 * t7i - c7 * t8i + c6 * t9i + c9 * t10i
    let y9r = c7 * t6r + c9 * t7r - c10 * t8r - c8 * t9r - c6 * t10r
    let y9i = c7 * t6i + c9 * t7i - c10 * t8i - c8 * t9i - c6 * t10i
    let y10r = c6 * t6r + c7 * t7r + c8 * t8r + c9 * t9r + c10 * t10r
    let y10i = c6 * t6i + c7 * t7i + c8 * t8i + c9 * t9i + c10 * t10i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i
    re[p1] = y1r - y10i
    im[p1] = y1i + y10r
    re[p2] = y2r - y9i
    im[p2] = y2i + y9r
    re[p3] = y3r - y8i
    im[p3] = y3i + y8r
    re[p4] = y4r - y7i
    im[p4] = y4i + y7r
    re[p5] = y5r - y6i
    im[p5] = y5i + y6r
    re[p6] = y5r + y6i
    im[p6] = y5i - y6r
    re[p7] = y4r + y7i
    im[p7] = y4i - y7r
    re[p8] = y3r + y8i
    im[p8] = y3i - y8r
    re[p9] = y2r + y9i
    im[p9] = y2i - y9r
    re[p10] = y1r + y10i
    im[p10] = y1i - y10r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 11 stage of the prime factor
/// transform, for the twist 2.
///
/// This is the small transform of the original, `Pfacc.pfa11`,
/// with the twist 2.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r11_mu2(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 11
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 11)
  let mut p1 = m * (1 * kfac % 11)
  let mut p2 = m * (2 * kfac % 11)
  let mut p3 = m * (3 * kfac % 11)
  let mut p4 = m * (4 * kfac % 11)
  let mut p5 = m * (5 * kfac % 11)
  let mut p6 = m * (6 * kfac % 11)
  let mut p7 = m * (7 * kfac % 11)
  let mut p8 = m * (8 * kfac % 11)
  let mut p9 = m * (9 * kfac % 11)
  let mut p10 = m * (10 * kfac % 11)
  let c1 = 0.4154150130018871
  let c2 = -0.6548607339452843
  let c3 = -0.9594929736144975
  let c4 = -0.14231483827328606
  let c5 = 0.8412535328311814
  let c6 = 0.909631995354518
  let c7 = 0.7557495743542588
  let c8 = -0.2817325568414299
  let c9 = -0.9898214418809324
  let c10 = -0.5406408174555981
  let mut i = 0
  while i < m {
    let t1r = re[p1] + re[p10]
    let t1i = im[p1] + im[p10]
    let t2r = re[p2] + re[p9]
    let t2i = im[p2] + im[p9]
    let t3r = re[p3] + re[p8]
    let t3i = im[p3] + im[p8]
    let t4r = re[p4] + re[p7]
    let t4i = im[p4] + im[p7]
    let t5r = re[p5] + re[p6]
    let t5i = im[p5] + im[p6]
    let t6r = re[p1] - re[p10]
    let t6i = im[p1] - im[p10]
    let t7r = re[p2] - re[p9]
    let t7i = im[p2] - im[p9]
    let t8r = re[p3] - re[p8]
    let t8i = im[p3] - im[p8]
    let t9r = re[p4] - re[p7]
    let t9i = im[p4] - im[p7]
    let t10r = re[p5] - re[p6]
    let t10i = im[p5] - im[p6]
    let t11r = re[p0] - 0.5 * t5r
    let t11i = im[p0] - 0.5 * t5i
    let t12r = t1r - t5r
    let t12i = t1i - t5i
    let t13r = t2r - t5r
    let t13i = t2i - t5i
    let t14r = t3r - t5r
    let t14i = t3i - t5i
    let t15r = t4r - t5r
    let t15i = t4i - t5i
    let y1r = t11r + c1 * t12r + c2 * t13r + c3 * t14r + c4 * t15r
    let y1i = t11i + c1 * t12i + c2 * t13i + c3 * t14i + c4 * t15i
    let y2r = t11r + c2 * t12r + c4 * t13r + c5 * t14r + c3 * t15r
    let y2i = t11i + c2 * t12i + c4 * t13i + c5 * t14i + c3 * t15i
    let y3r = t11r + c3 * t12r + c5 * t13r + c2 * t14r + c1 * t15r
    let y3i = t11i + c3 * t12i + c5 * t13i + c2 * t14i + c1 * t15i
    let y4r = t11r + c4 * t12r + c3 * t13r + c1 * t14r + c5 * t15r
    let y4i = t11i + c4 * t12i + c3 * t13i + c1 * t14i + c5 * t15i
    let y5r = t11r + c5 * t12r + c1 * t13r + c4 * t14r + c2 * t15r
    let y5i = t11i + c5 * t12i + c1 * t13i + c4 * t14i + c2 * t15i
    let y6r = c10 * t6r - c6 * t7r + c9 * t8r - c7 * t9r + c8 * t10r
    let y6i = c10 * t6i - c6 * t7i + c9 * t8i - c7 * t9i + c8 * t10i
    let y7r = c9 * t6r - c8 * t7r + c6 * t8r + c10 * t9r - c7 * t10r
    let y7i = c9 * t6i - c8 * t7i + c6 * t8i + c10 * t9i - c7 * t10i
    let y8r = c8 * t6r - c10 * t7r - c7 * t8r + c6 * t9r + c9 * t10r
    let y8i = c8 * t6i - c10 * t7i - c7 * t8i + c6 * t9i + c9 * t10i
    let y9r = c7 * t6r + c9 * t7r - c10 * t8r - c8 * t9r - c6 * t10r
    let y9i = c7 * t6i + c9 * t7i - c10 * t8i - c8 * t9i - c6 * t10i
    let y10r = c6 * t6r + c7 * t7r + c8 * t8r + c9 * t9r + c10 * t10r
    let y10i = c6 * t6i + c7 * t7i + c8 * t8i + c9 * t9i + c10 * t10i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i
    re[p1] = y1r - y10i
    im[p1] = y1i + y10r
    re[p2] = y2r - y9i
    im[p2] = y2i + y9r
    re[p3] = y3r - y8i
    im[p3] = y3i + y8r
    re[p4] = y4r - y7i
    im[p4] = y4i + y7r
    re[p5] = y5r - y6i
    im[p5] = y5i + y6r
    re[p6] = y5r + y6i
    im[p6] = y5i - y6r
    re[p7] = y4r + y7i
    im[p7] = y4i - y7r
    re[p8] = y3r + y8i
    im[p8] = y3i - y8r
    re[p9] = y2r + y9i
    im[p9] = y2i - y9r
    re[p10] = y1r + y10i
    im[p10] = y1i - y10r
    if p0 < limit {
