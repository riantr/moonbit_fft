    let t4i = im[p1] - im[p5]
    let t5r = re[p2] + re[p6]
    let t5i = im[p2] + im[p6]
    let t6r = c1 * (re[p2] - re[p6])
    let t6i = c1 * (im[p2] - im[p6])
    let t7r = re[p3] + re[p7]
    let t7i = im[p3] + im[p7]
    let t8r = re[p3] - re[p7]
    let t8i = im[p3] - im[p7]
    let t9r = t1r + t5r
    let t9i = t1i + t5i
    let t10r = t3r + t7r
    let t10i = t3i + t7i
    let t11r = c2 * (t4r - t8r)
    let t11i = c2 * (t4i - t8i)
    let t12r = c3 * (t4r + t8r)
    let t12i = c3 * (t4i + t8i)
    let y1r = t2r + t11r
    let y1i = t2i + t11i
    let y2r = t1r - t5r
    let y2i = t1i - t5i
    let y3r = t2r - t11r
    let y3i = t2i - t11i
    let y5r = t12r - t6r
    let y5i = t12i - t6i
    let y6r = c1 * (t3r - t7r)
    let y6i = c1 * (t3i - t7i)
    let y7r = t12r + t6r
    let y7i = t12i + t6i
    re[p0] = t9r + t10r
    im[p0] = t9i + t10i
    re[p1] = y1r - y7i
    im[p1] = y1i + y7r
    re[p2] = y2r - y6i
    im[p2] = y2i + y6r
    re[p3] = y3r - y5i
    im[p3] = y3i + y5r
    re[p4] = t9r - t10r
    im[p4] = t9i - t10i
    re[p5] = y3r + y5i
    im[p5] = y3i - y5r
    re[p6] = y2r + y6i
    im[p6] = y2i - y6r
    re[p7] = y1r + y7i
    im[p7] = y1i - y7r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
