    let t13i = t2i - t5i
    let t14r = t3r - t5r
    let t14i = t3i - t5i
    let t15r = t4r - t5r
    let t15i = t4i - t5i
    let y1r = t11r + c1 * t12r + c2 * t13r + c3 * t14r + c4 * t15r
    let y1i = t11i + c1 * t12i + c2 * t13i + c3 * t14i + c4 * t15i
    let y2r = t11r + c2 * t12r + c4 * t13r + c5 * t14r + c3 * t15r
    let y2i = t11i + c2 * t12i + c4 * t13i + c5 * t14i + c3 * t15i
