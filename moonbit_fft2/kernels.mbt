    let y4r = t13r + c4 * t14r + c5 * t15r + c1 * t16r + c3 * t17r + c6 * t18r
    let y4i = t13i + c4 * t14i + c5 * t15i + c1 * t16i + c3 * t17i + c6 * t18i
    let y5r = t13r + c5 * t14r + c3 * t15r + c2 * t16r + c6 * t17r + c1 * t18r
    let y5i = t13i + c5 * t14i + c3 * t15i + c2 * t16i + c6 * t17i + c1 * t18i
    let y6r = t13r + c6 * t14r + c1 * t15r + c5 * t16r + c2 * t17r + c4 * t18r
    let y6i = t13i + c6 * t14i + c1 * t15i + c5 * t16i + c2 * t17i + c4 * t18i
    let y7r = c12 * t7r -
      c7 * t8r +
      c11 * t9r -
      c8 * t10r +
      c10 * t11r -
      c9 * t12r
    let y7i = c12 * t7i -
      c7 * t8i +
      c11 * t9i -
      c8 * t10i +
      c10 * t11i -
      c9 * t12i
    let y8r = c11 * t7r -
      c9 * t8r +
      c8 * t9r -
      c12 * t10r -
      c7 * t11r +
      c10 * t12r
    let y8i = c11 * t7i -
      c9 * t8i +
      c8 * t9i -
      c12 * t10i -
      c7 * t11i +
      c10 * t12i
    let y9r = c10 * t7r -
      c11 * t8r -
      c7 * t9r +
      c9 * t10r -
      c12 * t11r -
      c8 * t12r
    let y9i = c10 * t7i -
      c11 * t8i -
      c7 * t9i +
      c9 * t10i -
      c12 * t11i -
      c8 * t12i
    let y10r = c9 * t7r +
      c12 * t8r -
      c10 * t9r -
      c7 * t10r +
      c8 * t11r +
      c11 * t12r
    let y10i = c9 * t7i +
      c12 * t8i -
      c10 * t9i -
      c7 * t10i +
      c8 * t11i +
      c11 * t12i
    let y11r = c8 * t7r +
      c10 * t8r +
      c12 * t9r -
      c11 * t10r -
      c9 * t11r -
      c7 * t12r
    let y11i = c8 * t7i +
      c10 * t8i +
      c12 * t9i -
      c11 * t10i -
      c9 * t11i -
      c7 * t12i
    let y12r = c7 * t7r +
      c8 * t8r +
      c9 * t9r +
      c10 * t10r +
      c11 * t11r +
      c12 * t12r
    let y12i = c7 * t7i +
      c8 * t8i +
      c9 * t9i +
      c10 * t10i +
      c11 * t11i +
      c12 * t12i
    re[p0] = re[p0] + t1r + t2r + t3r + t4r + t5r + t6r
    im[p0] = im[p0] + t1i + t2i + t3i + t4i + t5i + t6i
    re[p1] = y1r - y12i
    im[p1] = y1i + y12r
    re[p2] = y2r - y11i
    im[p2] = y2i + y11r
    re[p3] = y3r - y10i
    im[p3] = y3i + y10r
    re[p4] = y4r - y9i
    im[p4] = y4i + y9r
    re[p5] = y5r - y8i
    im[p5] = y5i + y8r
    re[p6] = y6r - y7i
    im[p6] = y6i + y7r
    re[p7] = y6r + y7i
    im[p7] = y6i - y7r
    re[p8] = y5r + y8i
    im[p8] = y5i - y8r
    re[p9] = y4r + y9i
    im[p9] = y4i - y9r
    re[p10] = y3r + y10i
    im[p10] = y3i - y10r
    re[p11] = y2r + y11i
