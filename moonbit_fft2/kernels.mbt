    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    if p11 < limit {
      p11 = p11 + mr
    }
    p11 = p11 + delta
    if p12 < limit {
      p12 = p12 + mr
    }
    p12 = p12 + delta
    if p13 < limit {
      p13 = p13 + mr
    }
    p13 = p13 + delta
    if p14 < limit {
      p14 = p14 + mr
    }
    p14 = p14 + delta
    if p15 < limit {
      p15 = p15 + mr
    }
    p15 = p15 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 16 stage of the prime factor
/// transform, for the twist 15.
///
/// This is the small transform of the original, `Pfacc.pfa16`,
/// with the twist 15.  Its constants are solved in double
/// precision, see `tools/solve_constants.py`.

///|
fn stage_r16_mu15(
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 16
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 16)
  let mut p1 = m * (1 * kfac % 16)
  let mut p2 = m * (2 * kfac % 16)
  let mut p3 = m * (3 * kfac % 16)
  let mut p4 = m * (4 * kfac % 16)
  let mut p5 = m * (5 * kfac % 16)
  let mut p6 = m * (6 * kfac % 16)
  let mut p7 = m * (7 * kfac % 16)
  let mut p8 = m * (8 * kfac % 16)
  let mut p9 = m * (9 * kfac % 16)
  let mut p10 = m * (10 * kfac % 16)
  let mut p11 = m * (11 * kfac % 16)
  let mut p12 = m * (12 * kfac % 16)
  let mut p13 = m * (13 * kfac % 16)
  let mut p14 = m * (14 * kfac % 16)
  let mut p15 = m * (15 * kfac % 16)
  let c1 = -1.0
  let c2 = 0.9238795325112883
  let c3 = -0.3826834323650863
  let c4 = 0.7071067811865476
  let c5 = -0.7071067811865476
  let c6 = 0.3826834323650863
  let c7 = -0.9238795325112883
  let mut i = 0
  while i < m {
    let t1r = re[p0] + re[p8]
    let t1i = im[p0] + im[p8]
    let t2r = re[p4] + re[p12]
    let t2i = im[p4] + im[p12]
    let t3r = re[p0] - re[p8]
    let t3i = im[p0] - im[p8]
    let t4r = c1 * (re[p4] - re[p12])
    let t4i = c1 * (im[p4] - im[p12])
    let t5r = t1r + t2r
    let t5i = t1i + t2i
    let t6r = t1r - t2r
    let t6i = t1i - t2i
    let t7r = re[p1] + re[p9]
    let t7i = im[p1] + im[p9]
    let t8r = re[p5] + re[p13]
    let t8i = im[p5] + im[p13]
    let t9r = re[p1] - re[p9]
    let t9i = im[p1] - im[p9]
    let t10r = re[p5] - re[p13]
    let t10i = im[p5] - im[p13]
    let t11r = t7r + t8r
    let t11i = t7i + t8i
    let t12r = t7r - t8r
    let t12i = t7i - t8i
    let t13r = re[p2] + re[p10]
    let t13i = im[p2] + im[p10]
    let t14r = re[p6] + re[p14]
    let t14i = im[p6] + im[p14]
    let t15r = re[p2] - re[p10]
    let t15i = im[p2] - im[p10]
    let t16r = re[p6] - re[p14]
    let t16i = im[p6] - im[p14]
    let t17r = t13r + t14r
    let t17i = t13i + t14i
    let t18r = c4 * (t15r - t16r)
    let t18i = c4 * (t15i - t16i)
    let t19r = c5 * (t15r + t16r)
    let t19i = c5 * (t15i + t16i)
    let t20r = c1 * (t13r - t14r)
    let t20i = c1 * (t13i - t14i)
    let t21r = re[p3] + re[p11]
    let t21i = im[p3] + im[p11]
    let t22r = re[p7] + re[p15]
    let t22i = im[p7] + im[p15]
    let t23r = re[p3] - re[p11]
    let t23i = im[p3] - im[p11]
    let t24r = re[p7] - re[p15]
    let t24i = im[p7] - im[p15]
    let t25r = t21r + t22r
    let t25i = t21i + t22i
    let t26r = t21r - t22r
    let t26i = t21i - t22i
    let t27r = t9r + t24r
    let t27i = t9i + t24i
    let t28r = t10r + t23r
    let t28i = t10i + t23i
    let t29r = t9r - t24r
    let t29i = t9i - t24i
    let t30r = t10r - t23r
    let t30i = t10i - t23i
    let t31r = t5r + t17r
    let t31i = t5i + t17i
    let t32r = t11r + t25r
    let t32i = t11i + t25i
    let t33r = t3r + t18r
    let t33i = t3i + t18i
    let t34r = c2 * t29r - c6 * t30r
    let t34i = c2 * t29i - c6 * t30i
    let t35r = t3r - t18r
    let t35i = t3i - t18i
    let t36r = c7 * t27r - c3 * t28r
    let t36i = c7 * t27i - c3 * t28i
    let t37r = t4r + t19r
    let t37i = t4i + t19i
    let t38r = c3 * t27r + c7 * t28r
    let t38i = c3 * t27i + c7 * t28i
    let t39r = t4r - t19r
    let t39i = t4i - t19i
    let t40r = c6 * t29r + c2 * t30r
    let t40i = c6 * t29i + c2 * t30i
    let t41r = c4 * (t12r - t26r)
    let t41i = c4 * (t12i - t26i)
    let t42r = c5 * (t12r + t26r)
    let t42i = c5 * (t12i + t26i)
    let y1r = t33r + t34r
    let y1i = t33i + t34i
    let y2r = t6r + t41r
    let y2i = t6i + t41i
    let y3r = t35r + t40r
    let y3i = t35i + t40i
    let y4r = t5r - t17r
    let y4i = t5i - t17i
    let y5r = t35r - t40r
    let y5i = t35i - t40i
    let y6r = t6r - t41r
    let y6i = t6i - t41i
    let y7r = t33r - t34r
    let y7i = t33i - t34i
    let y9r = t38r - t37r
    let y9i = t38i - t37i
    let y10r = t42r - t20r
    let y10i = t42i - t20i
    let y11r = t36r + t39r
    let y11i = t36i + t39i
    let y12r = c1 * (t11r - t25r)
    let y12i = c1 * (t11i - t25i)
    let y13r = t36r - t39r
    let y13i = t36i - t39i
    let y14r = t42r + t20r
    let y14i = t42i + t20i
    let y15r = t38r + t37r
    let y15i = t38i + t37i
    re[p0] = t31r + t32r
    im[p0] = t31i + t32i
    re[p1] = y1r - y15i
    im[p1] = y1i + y15r
    re[p2] = y2r - y14i
    im[p2] = y2i + y14r
    re[p3] = y3r - y13i
    im[p3] = y3i + y13r
    re[p4] = y4r - y12i
    im[p4] = y4i + y12r
    re[p5] = y5r - y11i
    im[p5] = y5i + y11r
    re[p6] = y6r - y10i
    im[p6] = y6i + y10r
    re[p7] = y7r - y9i
    im[p7] = y7i + y9r
    re[p8] = t31r - t32r
    im[p8] = t31i - t32i
    re[p9] = y7r + y9i
    im[p9] = y7i - y9r
    re[p10] = y6r + y10i
    im[p10] = y6i - y10r
    re[p11] = y5r + y11i
    im[p11] = y5i - y11r
    re[p12] = y4r + y12i
    im[p12] = y4i - y12r
    re[p13] = y3r + y13i
    im[p13] = y3i - y13r
    re[p14] = y2r + y14i
    im[p14] = y2i - y14r
    re[p15] = y1r + y15i
    im[p15] = y1i - y15r
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    if p9 < limit {
      p9 = p9 + mr
    }
    p9 = p9 + delta
    if p10 < limit {
      p10 = p10 + mr
    }
    p10 = p10 + delta
    if p11 < limit {
      p11 = p11 + mr
    }
    p11 = p11 + delta
    if p12 < limit {
      p12 = p12 + mr
    }
    p12 = p12 + delta
    if p13 < limit {
      p13 = p13 + mr
    }
    p13 = p13 + delta
    if p14 < limit {
      p14 = p14 + mr
    }
    p14 = p14 + delta
    if p15 < limit {
      p15 = p15 + mr
    }
    p15 = p15 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// Calls the butterfly of a radix and a twist.
///
/// The twist of the stage is the exponent of the roots of unity
/// of its small transform.

///|
fn stage_dispatch(
  r : Int32,
  mu : Int32,
  m : Int32,
  kfac : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  if r == 2 {
    if mu == 1 {
      stage_r2_mu1(m, kfac, re, im)
    }
  } else if r == 3 {
    if mu == 1 {
      stage_r3_mu1(m, kfac, re, im)
    } else if mu == 2 {
      stage_r3_mu2(m, kfac, re, im)
    }
  } else if r == 4 {
    if mu == 1 {
      stage_r4_mu1(m, kfac, re, im)
    } else if mu == 3 {
      stage_r4_mu3(m, kfac, re, im)
    }
  } else if r == 5 {
    if mu == 1 {
      stage_r5_mu1(m, kfac, re, im)
    } else if mu == 2 {
      stage_r5_mu2(m, kfac, re, im)
    } else if mu == 3 {
      stage_r5_mu3(m, kfac, re, im)
    } else if mu == 4 {
      stage_r5_mu4(m, kfac, re, im)
    }
  } else if r == 7 {
    if mu == 1 {
      stage_r7_mu1(m, kfac, re, im)
    } else if mu == 2 {
      stage_r7_mu2(m, kfac, re, im)
    } else if mu == 3 {
      stage_r7_mu3(m, kfac, re, im)
    } else if mu == 4 {
      stage_r7_mu4(m, kfac, re, im)
    } else if mu == 5 {
      stage_r7_mu5(m, kfac, re, im)
    } else if mu == 6 {
      stage_r7_mu6(m, kfac, re, im)
    }
  } else if r == 8 {
    if mu == 1 {
      stage_r8_mu1(m, kfac, re, im)
    } else if mu == 3 {
      stage_r8_mu3(m, kfac, re, im)
    } else if mu == 5 {
      stage_r8_mu5(m, kfac, re, im)
    } else if mu == 7 {
      stage_r8_mu7(m, kfac, re, im)
    }
  } else if r == 9 {
    if mu == 1 {
      stage_r9_mu1(m, kfac, re, im)
    } else if mu == 2 {
      stage_r9_mu2(m, kfac, re, im)
    } else if mu == 4 {
      stage_r9_mu4(m, kfac, re, im)
    } else if mu == 5 {
      stage_r9_mu5(m, kfac, re, im)
    } else if mu == 7 {
      stage_r9_mu7(m, kfac, re, im)
    } else if mu == 8 {
      stage_r9_mu8(m, kfac, re, im)
    }
  } else if r == 11 {
    if mu == 1 {
      stage_r11_mu1(m, kfac, re, im)
    } else if mu == 2 {
      stage_r11_mu2(m, kfac, re, im)
    } else if mu == 3 {
      stage_r11_mu3(m, kfac, re, im)
    } else if mu == 4 {
      stage_r11_mu4(m, kfac, re, im)
    } else if mu == 5 {
      stage_r11_mu5(m, kfac, re, im)
    } else if mu == 6 {
      stage_r11_mu6(m, kfac, re, im)
    } else if mu == 7 {
      stage_r11_mu7(m, kfac, re, im)
    } else if mu == 8 {
      stage_r11_mu8(m, kfac, re, im)
    } else if mu == 9 {
      stage_r11_mu9(m, kfac, re, im)
    } else if mu == 10 {
      stage_r11_mu10(m, kfac, re, im)
    }
  } else if r == 13 {
    if mu == 1 {
      stage_r13_mu1(m, kfac, re, im)
    } else if mu == 2 {
      stage_r13_mu2(m, kfac, re, im)
    } else if mu == 3 {
      stage_r13_mu3(m, kfac, re, im)
    } else if mu == 4 {
      stage_r13_mu4(m, kfac, re, im)
    } else if mu == 5 {
      stage_r13_mu5(m, kfac, re, im)
    } else if mu == 6 {
      stage_r13_mu6(m, kfac, re, im)
    } else if mu == 7 {
      stage_r13_mu7(m, kfac, re, im)
    } else if mu == 8 {
      stage_r13_mu8(m, kfac, re, im)
    } else if mu == 9 {
      stage_r13_mu9(m, kfac, re, im)
    } else if mu == 10 {
      stage_r13_mu10(m, kfac, re, im)
    } else if mu == 11 {
      stage_r13_mu11(m, kfac, re, im)
    } else if mu == 12 {
      stage_r13_mu12(m, kfac, re, im)
    }
  } else if r == 16 {
    if mu == 1 {
      stage_r16_mu1(m, kfac, re, im)
    } else if mu == 3 {
      stage_r16_mu3(m, kfac, re, im)
    } else if mu == 5 {
      stage_r16_mu5(m, kfac, re, im)
    } else if mu == 7 {
      stage_r16_mu7(m, kfac, re, im)
    } else if mu == 9 {
      stage_r16_mu9(m, kfac, re, im)
    } else if mu == 11 {
      stage_r16_mu11(m, kfac, re, im)
    } else if mu == 13 {
      stage_r16_mu13(m, kfac, re, im)
    } else if mu == 15 {
      stage_r16_mu15(m, kfac, re, im)
    }
  } else {
    abort("the transform length has a factor without a butterfly")
  }
}
