    let a1_re = v1_re + v7_re
    let a1_im = v1_im + v7_im
    let b1_re = v1_re - v7_re
    let b1_im = v1_im - v7_im
    let a2_re = v2_re + v6_re
    let a2_im = v2_im + v6_im
    let b2_re = v2_re - v6_re
    let b2_im = v2_im - v6_im
    let a3_re = v3_re + v5_re
    let a3_im = v3_im + v5_im
    let b3_re = v3_re - v5_re
    let b3_im = v3_im - v5_im
    let mut out0_re = 0.0
    let mut out0_im = 0.0
    out0_re = out0_re + v0_re
    out0_im = out0_im + v0_im
    out0_re = out0_re + v1_re
    out0_im = out0_im + v1_im
    out0_re = out0_re + v2_re
    out0_im = out0_im + v2_im
    out0_re = out0_re + v3_re
    out0_im = out0_im + v3_im
    out0_re = out0_re + v4_re
    out0_im = out0_im + v4_im
    out0_re = out0_re + v5_re
    out0_im = out0_im + v5_im
    out0_re = out0_re + v6_re
    out0_im = out0_im + v6_im
    out0_re = out0_re + v7_re
    out0_im = out0_im + v7_im
    let mut out4_re = 0.0
    let mut out4_im = 0.0
    out4_re = out4_re + v0_re
    out4_im = out4_im + v0_im
    out4_re = out4_re - v1_re
    out4_im = out4_im - v1_im
    out4_re = out4_re + v2_re
    out4_im = out4_im + v2_im
    out4_re = out4_re - v3_re
    out4_im = out4_im - v3_im
    out4_re = out4_re + v4_re
    out4_im = out4_im + v4_im
    out4_re = out4_re - v5_re
    out4_im = out4_im - v5_im
    out4_re = out4_re + v6_re
    out4_im = out4_im + v6_im
    out4_re = out4_re - v7_re
    out4_im = out4_im - v7_im
    let mut out1_re = 0.0
    let mut out1_im = 0.0
    let mut out7_re = 0.0
    let mut out7_im = 0.0
    let mut c1_re = 0.0
    let mut c1_im = 0.0
    c1_re = v0_re
    c1_im = v0_im
    let mut d1_re = 0.0
    let mut d1_im = 0.0
    c1_re = c1_re + a1_re * c1
    c1_im = c1_im + a1_im * c1
    d1_re = d1_re + b1_re * s1
    d1_im = d1_im + b1_im * s1
    d1_re = d1_re + b2_re * s2
    d1_im = d1_im + b2_im * s2
    c1_re = c1_re + a3_re * c3
    c1_im = c1_im + a3_im * c3
    d1_re = d1_re + b3_re * s3
    d1_im = d1_im + b3_im * s3
    out1_re = c1_re + d1_im - v4_re
    out1_im = c1_im - d1_re - v4_im
    out7_re = c1_re - d1_im - v4_re
    out7_im = c1_im + d1_re - v4_im
    let mut out2_re = 0.0
    let mut out2_im = 0.0
    let mut out6_re = 0.0
    let mut out6_im = 0.0
    let mut c2_re = 0.0
    let mut c2_im = 0.0
    c2_re = v0_re
    c2_im = v0_im
    let mut d2_re = 0.0
    let mut d2_im = 0.0
    d2_re = d2_re + b1_re * s2
    d2_im = d2_im + b1_im * s2
    c2_re = c2_re - a2_re
    c2_im = c2_im - a2_im
    d2_re = d2_re - b3_re * s2
    d2_im = d2_im - b3_im * s2
    out2_re = c2_re + d2_im + v4_re
    out2_im = c2_im - d2_re + v4_im
    out6_re = c2_re - d2_im + v4_re
    out6_im = c2_im + d2_re + v4_im
    let mut out3_re = 0.0
    let mut out3_im = 0.0
    let mut out5_re = 0.0
    let mut out5_im = 0.0
    let mut c3_re = 0.0
    let mut c3_im = 0.0
    c3_re = v0_re
    c3_im = v0_im
    let mut d3_re = 0.0
    let mut d3_im = 0.0
    c3_re = c3_re + a1_re * c3
    c3_im = c3_im + a1_im * c3
    d3_re = d3_re + b1_re * s3
    d3_im = d3_im + b1_im * s3
    d3_re = d3_re - b2_re * s2
    d3_im = d3_im - b2_im * s2
    c3_re = c3_re + a3_re * c1
    c3_im = c3_im + a3_im * c1
    d3_re = d3_re + b3_re * s1
    d3_im = d3_im + b3_im * s1
    out3_re = c3_re + d3_im - v4_re
    out3_im = c3_im - d3_re - v4_im
    out5_re = c3_re - d3_im - v4_re
    out5_im = c3_im + d3_re - v4_im
    re[p0] = out0_re
    im[p0] = out0_im
    re[p1] = out1_re
    im[p1] = out1_im
    re[p2] = out2_re
    im[p2] = out2_im
    re[p3] = out3_re
    im[p3] = out3_im
    re[p4] = out4_re
    im[p4] = out4_im
    re[p5] = out5_re
    im[p5] = out5_im
    re[p6] = out6_re
    im[p6] = out6_im
    re[p7] = out7_re
    im[p7] = out7_im
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 9 stage of the Good-Thomas transform.
///
/// The values of the butterfly are read from `re` and `im`, the
/// roots of unity of the stage from `consts`, and the result is
/// written back to `re` and `im`.
///
/// The constants of the stage start at `off` in `consts`: the
/// cosines of the 5 roots come first, then the sines.
fn stage_r9(
  m : Int32,
  kfac : Int32,
  consts : Array[Double],
  off : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 9
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 9)
  let mut p1 = m * (1 * kfac % 9)
  let mut p2 = m * (2 * kfac % 9)
  let mut p3 = m * (3 * kfac % 9)
  let mut p4 = m * (4 * kfac % 9)
  let mut p5 = m * (5 * kfac % 9)
  let mut p6 = m * (6 * kfac % 9)
  let mut p7 = m * (7 * kfac % 9)
  let mut p8 = m * (8 * kfac % 9)
  let c1 = consts[off + 1]
  let c2 = consts[off + 2]
  let c3 = consts[off + 3]
  let c4 = consts[off + 4]
  let s1 = consts[off + 6]
  let s2 = consts[off + 7]
  let s3 = consts[off + 8]
  let s4 = consts[off + 9]
  let mut i = 0
  while i < m {
    let v0_re = re[p0]
    let v0_im = im[p0]
    let v1_re = re[p1]
    let v1_im = im[p1]
    let v2_re = re[p2]
    let v2_im = im[p2]
    let v3_re = re[p3]
    let v3_im = im[p3]
    let v4_re = re[p4]
    let v4_im = im[p4]
    let v5_re = re[p5]
    let v5_im = im[p5]
    let v6_re = re[p6]
    let v6_im = im[p6]
    let v7_re = re[p7]
    let v7_im = im[p7]
    let v8_re = re[p8]
    let v8_im = im[p8]
    let a1_re = v1_re + v8_re
    let a1_im = v1_im + v8_im
    let b1_re = v1_re - v8_re
    let b1_im = v1_im - v8_im
    let a2_re = v2_re + v7_re
    let a2_im = v2_im + v7_im
    let b2_re = v2_re - v7_re
    let b2_im = v2_im - v7_im
    let a3_re = v3_re + v6_re
    let a3_im = v3_im + v6_im
    let b3_re = v3_re - v6_re
    let b3_im = v3_im - v6_im
    let a4_re = v4_re + v5_re
    let a4_im = v4_im + v5_im
    let b4_re = v4_re - v5_re
    let b4_im = v4_im - v5_im
    let mut out0_re = v0_re
    let mut out0_im = v0_im
    out0_re = out0_re + a1_re
    out0_im = out0_im + a1_im
    out0_re = out0_re + a2_re
    out0_im = out0_im + a2_im
    out0_re = out0_re + a3_re
    out0_im = out0_im + a3_im
    out0_re = out0_re + a4_re
    out0_im = out0_im + a4_im
    let mut out1_re = 0.0
    let mut out1_im = 0.0
    let mut out8_re = 0.0
    let mut out8_im = 0.0
    let mut c1_re = 0.0
    let mut c1_im = 0.0
    c1_re = v0_re
    c1_im = v0_im
    let mut d1_re = 0.0
    let mut d1_im = 0.0
    c1_re = c1_re + a1_re * c1
    c1_im = c1_im + a1_im * c1
    d1_re = d1_re + b1_re * s1
    d1_im = d1_im + b1_im * s1
    c1_re = c1_re + a2_re * c2
    c1_im = c1_im + a2_im * c2
    d1_re = d1_re + b2_re * s2
    d1_im = d1_im + b2_im * s2
    c1_re = c1_re + a3_re * c3
    c1_im = c1_im + a3_im * c3
    d1_re = d1_re + b3_re * s3
    d1_im = d1_im + b3_im * s3
    c1_re = c1_re + a4_re * c4
    c1_im = c1_im + a4_im * c4
    d1_re = d1_re + b4_re * s4
    d1_im = d1_im + b4_im * s4
    out1_re = c1_re + d1_im
    out1_im = c1_im - d1_re
    out8_re = c1_re - d1_im
    out8_im = c1_im + d1_re
    let mut out2_re = 0.0
    let mut out2_im = 0.0
    let mut out7_re = 0.0
    let mut out7_im = 0.0
    let mut c2_re = 0.0
    let mut c2_im = 0.0
    c2_re = v0_re
    c2_im = v0_im
    let mut d2_re = 0.0
    let mut d2_im = 0.0
    c2_re = c2_re + a1_re * c2
    c2_im = c2_im + a1_im * c2
    d2_re = d2_re + b1_re * s2
    d2_im = d2_im + b1_im * s2
    c2_re = c2_re + a2_re * c4
    c2_im = c2_im + a2_im * c4
    d2_re = d2_re + b2_re * s4
    d2_im = d2_im + b2_im * s4
    c2_re = c2_re + a3_re * c3
    c2_im = c2_im + a3_im * c3
    d2_re = d2_re - b3_re * s3
    d2_im = d2_im - b3_im * s3
    c2_re = c2_re + a4_re * c1
    c2_im = c2_im + a4_im * c1
    d2_re = d2_re - b4_re * s1
    d2_im = d2_im - b4_im * s1
    out2_re = c2_re + d2_im
    out2_im = c2_im - d2_re
    out7_re = c2_re - d2_im
    out7_im = c2_im + d2_re
    let mut out3_re = 0.0
    let mut out3_im = 0.0
    let mut out6_re = 0.0
    let mut out6_im = 0.0
    let mut c3_re = 0.0
    let mut c3_im = 0.0
    c3_re = v0_re
    c3_im = v0_im
    let mut d3_re = 0.0
    let mut d3_im = 0.0
    c3_re = c3_re + a1_re * c3
    c3_im = c3_im + a1_im * c3
    d3_re = d3_re + b1_re * s3
    d3_im = d3_im + b1_im * s3
    c3_re = c3_re + a2_re * c3
    c3_im = c3_im + a2_im * c3
    d3_re = d3_re - b2_re * s3
    d3_im = d3_im - b2_im * s3
    c3_re = c3_re + a3_re
    c3_im = c3_im + a3_im
    c3_re = c3_re + a4_re * c3
    c3_im = c3_im + a4_im * c3
    d3_re = d3_re + b4_re * s3
    d3_im = d3_im + b4_im * s3
    out3_re = c3_re + d3_im
    out3_im = c3_im - d3_re
    out6_re = c3_re - d3_im
    out6_im = c3_im + d3_re
    let mut out4_re = 0.0
    let mut out4_im = 0.0
    let mut out5_re = 0.0
    let mut out5_im = 0.0
    let mut c4_re = 0.0
    let mut c4_im = 0.0
    c4_re = v0_re
    c4_im = v0_im
    let mut d4_re = 0.0
    let mut d4_im = 0.0
    c4_re = c4_re + a1_re * c4
    c4_im = c4_im + a1_im * c4
    d4_re = d4_re + b1_re * s4
    d4_im = d4_im + b1_im * s4
    c4_re = c4_re + a2_re * c1
    c4_im = c4_im + a2_im * c1
    d4_re = d4_re - b2_re * s1
    d4_im = d4_im - b2_im * s1
    c4_re = c4_re + a3_re * c3
    c4_im = c4_im + a3_im * c3
    d4_re = d4_re + b3_re * s3
    d4_im = d4_im + b3_im * s3
    c4_re = c4_re + a4_re * c2
    c4_im = c4_im + a4_im * c2
    d4_re = d4_re - b4_re * s2
    d4_im = d4_im - b4_im * s2
    out4_re = c4_re + d4_im
    out4_im = c4_im - d4_re
    out5_re = c4_re - d4_im
    out5_im = c4_im + d4_re
    re[p0] = out0_re
    im[p0] = out0_im
    re[p1] = out1_re
    im[p1] = out1_im
    re[p2] = out2_re
    im[p2] = out2_im
    re[p3] = out3_re
    im[p3] = out3_im
    re[p4] = out4_re
    im[p4] = out4_im
    re[p5] = out5_re
    im[p5] = out5_im
    re[p6] = out6_re
    im[p6] = out6_im
    re[p7] = out7_re
    im[p7] = out7_im
    re[p8] = out8_re
    im[p8] = out8_im
    if p0 < limit {
      p0 = p0 + mr
    }
    p0 = p0 + delta
    if p1 < limit {
      p1 = p1 + mr
    }
    p1 = p1 + delta
    if p2 < limit {
      p2 = p2 + mr
    }
    p2 = p2 + delta
    if p3 < limit {
      p3 = p3 + mr
    }
    p3 = p3 + delta
    if p4 < limit {
      p4 = p4 + mr
    }
    p4 = p4 + delta
    if p5 < limit {
      p5 = p5 + mr
    }
    p5 = p5 + delta
    if p6 < limit {
      p6 = p6 + mr
    }
    p6 = p6 + delta
    if p7 < limit {
      p7 = p7 + mr
    }
    p7 = p7 + delta
    if p8 < limit {
      p8 = p8 + mr
    }
    p8 = p8 + delta
    limit = limit + 1
    i = i + 1
  }
}

///|
/// The butterfly of the radix 11 stage of the Good-Thomas transform.
///
/// The values of the butterfly are read from `re` and `im`, the
/// roots of unity of the stage from `consts`, and the result is
/// written back to `re` and `im`.
///
/// The constants of the stage start at `off` in `consts`: the
/// cosines of the 6 roots come first, then the sines.
fn stage_r11(
  m : Int32,
  kfac : Int32,
  consts : Array[Double],
  off : Int32,
  re : Array[Double],
  im : Array[Double],
) -> Unit {
  let mr = m * 11
  let delta = 1 - m * kfac
  let mut limit = m * kfac
  let mut p0 = m * (0 * kfac % 11)
  let mut p1 = m * (1 * kfac % 11)
  let mut p2 = m * (2 * kfac % 11)
  let mut p3 = m * (3 * kfac % 11)
  let mut p4 = m * (4 * kfac % 11)
  let mut p5 = m * (5 * kfac % 11)
  let mut p6 = m * (6 * kfac % 11)
  let mut p7 = m * (7 * kfac % 11)
  let mut p8 = m * (8 * kfac % 11)
  let mut p9 = m * (9 * kfac % 11)
  let mut p10 = m * (10 * kfac % 11)
  let c1 = consts[off + 1]
  let c2 = consts[off + 2]
  let c3 = consts[off + 3]
  let c4 = consts[off + 4]
  let c5 = consts[off + 5]
  let s1 = consts[off + 7]
  let s2 = consts[off + 8]
  let s3 = consts[off + 9]
  let s4 = consts[off + 10]
  let s5 = consts[off + 11]
  let mut i = 0
  while i < m {
    let v0_re = re[p0]
    let v0_im = im[p0]
    let v1_re = re[p1]
    let v1_im = im[p1]
    let v2_re = re[p2]
    let v2_im = im[p2]
    let v3_re = re[p3]
    let v3_im = im[p3]
    let v4_re = re[p4]
    let v4_im = im[p4]
    let v5_re = re[p5]
    let v5_im = im[p5]
    let v6_re = re[p6]
    let v6_im = im[p6]
    let v7_re = re[p7]
    let v7_im = im[p7]
    let v8_re = re[p8]
    let v8_im = im[p8]
    let v9_re = re[p9]
    let v9_im = im[p9]
    let v10_re = re[p10]
    let v10_im = im[p10]
    let a1_re = v1_re + v10_re
    let a1_im = v1_im + v10_im
    let b1_re = v1_re - v10_re
    let b1_im = v1_im - v10_im
    let a2_re = v2_re + v9_re
    let a2_im = v2_im + v9_im
    let b2_re = v2_re - v9_re
    let b2_im = v2_im - v9_im
    let a3_re = v3_re + v8_re
    let a3_im = v3_im + v8_im
    let b3_re = v3_re - v8_re
    let b3_im = v3_im - v8_im
    let a4_re = v4_re + v7_re
    let a4_im = v4_im + v7_im
    let b4_re = v4_re - v7_re
    let b4_im = v4_im - v7_im
    let a5_re = v5_re + v6_re
    let a5_im = v5_im + v6_im
    let b5_re = v5_re - v6_re
    let b5_im = v5_im - v6_im
    let mut out0_re = v0_re
    let mut out0_im = v0_im
    out0_re = out0_re + a1_re
    out0_im = out0_im + a1_im
    out0_re = out0_re + a2_re
    out0_im = out0_im + a2_im
    out0_re = out0_re + a3_re
    out0_im = out0_im + a3_im
    out0_re = out0_re + a4_re
    out0_im = out0_im + a4_im
    out0_re = out0_re + a5_re
    out0_im = out0_im + a5_im
    let mut out1_re = 0.0
    let mut out1_im = 0.0
    let mut out10_re = 0.0
    let mut out10_im = 0.0
    let mut c1_re = 0.0
    let mut c1_im = 0.0
    c1_re = v0_re
    c1_im = v0_im
    let mut d1_re = 0.0
    let mut d1_im = 0.0
    c1_re = c1_re + a1_re * c1
    c1_im = c1_im + a1_im * c1
    d1_re = d1_re + b1_re * s1
    d1_im = d1_im + b1_im * s1
    c1_re = c1_re + a2_re * c2
    c1_im = c1_im + a2_im * c2
    d1_re = d1_re + b2_re * s2
    d1_im = d1_im + b2_im * s2
    c1_re = c1_re + a3_re * c3
    c1_im = c1_im + a3_im * c3
    d1_re = d1_re + b3_re * s3
    d1_im = d1_im + b3_im * s3
    c1_re = c1_re + a4_re * c4
    c1_im = c1_im + a4_im * c4
    d1_re = d1_re + b4_re * s4
    d1_im = d1_im + b4_im * s4
